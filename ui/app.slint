// RyM Slint: the window app. The playing song on the left (big cover, wave progress, volume,
// controls), and on the right Up next with similar songs and the artist's songs, or the page
// picked in the rail (home, search, library, a list, settings). Sizes follow a 1600 x 1024
// layout and scale with the window (Ui.k).

import "fonts/Roboto-Regular.ttf";
import "fonts/Roboto-Bold.ttf";
import "fonts/Roboto-Light.ttf";
import "fonts/Chathura-Regular.ttf";
import { AboutSlint } from "std-widgets.slint";

export struct Song {
    key: string,
    title: string,
    artist: string,
    cover: image,
    liked: bool,
    playing: bool,
}

export struct Card {
    key: string,
    title: string,
    sub: string,
    cover: image,
}

export struct Shelf {
    title: string,
    cards: [Card],
}

export struct LyricLine {
    text: string,
    tr: string,
    // 0 to come, 1 sung now, 2 sung
    state: int,
}

export struct Suggest {
    text: string,
    history: bool,
}

export struct Toggle {
    id: string,
    title: string,
    about: string,
    on: bool,
}

// RyM Dusk (dark) and RyM Mist (light).
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #343345 : #e8e8e8;
    out property <color> raised: dark ? #3d3c50 : #f4f4f4;
    out property <color> text: dark ? #ffffff : #111111;
    out property <color> dim: dark ? #c6c6c6 : #4d4d55;
    out property <color> faint: dark ? #d5d5d5 : #5a5a62;
    out property <color> icon: dark ? #e4e3e3 : #3c3b4a;
    out property <color> handle: #666477;
    out property <color> accent: #ea814a;
    out property <color> bar: dark ? #d9d9d9 : #b4b3bd;
    out property <color> border: #666477.with-alpha(0.5);
    out property <color> hover: dark ? #ffffff12 : #0000000d;
    out property <color> wave-from: #f9d19e;
    out property <color> wave-to: #d53a0c;
}

// The scale of the 1600 x 1024 layout to the window.
export global Ui {
    in-out property <float> k: 1;
}

export global App {
    pure callback tr(string) -> string;

    // ---- the playing song
    in property <bool> has-song;
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <image> backdrop;
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> liked;
    in property <float> position;
    in property <float> duration;
    in property <string> pos-text: "0:00";
    in property <string> len-text: "0:00";
    in property <[float]> wave;
    in-out property <float> volume: 0.8;
    in property <bool> repeat-one;
    in-out property <bool> show-lyrics;
    in property <[LyricLine]> lyrics;
    in property <string> lyrics-note;
    in property <int> lyric-line: -1;
    in-out property <int> lyrics-size: 25;

    // ---- the right side
    // 0 now playing (Up next), 1 search, 2 library, 3 home, 4 settings, 5 a list
    in-out property <int> page: 0;
    in property <[Song]> queue;
    in-out property <bool> queue-open;
    in property <[Card]> similar;
    in property <[Card]> same-artist;
    in property <string> artist-name;
    in property <[Shelf]> home;
    in property <bool> home-loading;
    in property <[Song]> list;
    in property <string> list-title;
    in property <bool> list-loading;
    in property <bool> list-more;
    in property <[Card]> playlists;
    in property <[Suggest]> suggestions;
    in-out property <string> query;
    in property <[Song]> results;
    in property <bool> searching;

    // ---- account, settings, notices
    in property <bool> signed-in;
    in property <string> account-name;
    in property <string> account-handle;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <[Toggle]> toggles;
    in-out property <int> crossfade: 0;
    in property <string> version;
    in property <string> toast;
    in property <string> update-text;

    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback like-now();
    callback repeat();
    callback go(int);
    callback play(string);
    callback menu(string, string);
    callback open-card(string);
    callback search(string);
    callback typed(string);
    callback pick-suggestion(int);
    callback forget-suggestion(int);
    callback refresh-home();
    callback more();
    callback play-all();
    callback lyric-clicked(int);
    callback set-toggle(string, bool);
    callback set-number(string, int);
    callback sign-in();
    callback sign-out();
    callback check-updates();
    callback open-artist();
    callback mini();
}

// ---------------------------------------------------------------- small parts

component Icon inherits Rectangle {
    in property <image> source;
    in property <length> size: 48px * Ui.k;
    in property <color> tint: Theme.icon;
    in property <angle> turn: 0deg;
    in property <string> tip;
    callback clicked();
    width: size;
    height: size;
    background: area.has-hover ? Theme.hover : transparent;
    border-radius: size / 4;
    Image {
        width: parent.size * 0.86;
        height: parent.size * 0.86;
        source: root.source;
        colorize: root.tint;
        transform-rotation: root.turn;
        image-fit: contain;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: 6px * Ui.k;
    border-radius: radius;
    clip: true;
    background: Theme.raised;
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
}

// A song in a list: cover, title, artist (and the drag handle of the layout).
component SongRow inherits Rectangle {
    in property <Song> song;
    in property <bool> handle: true;
    in property <bool> in-queue;
    height: 106px * Ui.k;
    border-radius: 8px * Ui.k;
    background: song.playing ? Theme.hover : (area.has-hover ? Theme.hover : transparent);
    ContextMenuArea {
        Menu {
            MenuItem { title: App.tr("Play next"); activated => { App.menu("next", root.song.key); } }
            MenuItem { title: App.tr("Add to queue"); activated => { App.menu("add", root.song.key); } }
            MenuItem { title: root.song.liked ? App.tr("Remove from liked songs") : App.tr("Add to liked songs"); activated => { App.menu("like", root.song.key); } }
            MenuItem { title: App.tr("Go to artist"); activated => { App.menu("artist", root.song.key); } }
            MenuItem { title: App.tr("Download"); activated => { App.menu("download", root.song.key); } }
            MenuItem { title: App.tr("Copy link"); activated => { App.menu("share", root.song.key); } }
            if root.in-queue: MenuItem { title: App.tr("Remove from queue"); activated => { App.menu("remove", root.song.key); } }
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.play(root.song.key); }
        }
    }
    HorizontalLayout {
        padding: 12px * Ui.k;
        spacing: 24px * Ui.k;
        Cover {
            width: 82px * Ui.k;
            height: 82px * Ui.k;
            source: root.song.cover;
        }
        VerticalLayout {
            alignment: center;
            spacing: 14px * Ui.k;
            Text {
                text: root.song.title;
                font-size: 24px * Ui.k;
                font-weight: 700;
                color: root.song.playing ? Theme.accent : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.song.artist;
                font-size: 16px * Ui.k;
                color: Theme.dim;
                overflow: elide;
            }
        }
        if root.handle: VerticalLayout {
            alignment: center;
            spacing: 4px * Ui.k;
            width: 21px * Ui.k;
            for i in 3: Rectangle {
                height: 2px * Ui.k;
                background: Theme.handle;
            }
        }
    }
}

// A cover with its name under it (similar songs, the artist's songs, home shelves).
component CardItem inherits VerticalLayout {
    in property <Card> card;
    in property <length> size: 160px * Ui.k;
    padding: 12px * Ui.k;
    spacing: 18px * Ui.k;
    width: size + 24px * Ui.k;
    Rectangle {
        width: root.size;
        height: root.size;
        Cover {
            width: 100%;
            height: 100%;
            source: root.card.cover;
        }
        Rectangle {
            border-radius: 6px * Ui.k;
            background: area.has-hover ? #00000030 : transparent;
        }
        ContextMenuArea {
            Menu {
                MenuItem { title: App.tr("Play next"); activated => { App.menu("next", root.card.key); } }
                MenuItem { title: App.tr("Add to queue"); activated => { App.menu("add", root.card.key); } }
                MenuItem { title: App.tr("Go to artist"); activated => { App.menu("artist", root.card.key); } }
                MenuItem { title: App.tr("Copy link"); activated => { App.menu("share", root.card.key); } }
            }
            area := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.open-card(root.card.key); }
            }
        }
    }
    VerticalLayout {
        spacing: 10px * Ui.k;
        Text {
            text: root.card.title;
            font-size: 24px * Ui.k;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.card.sub;
            font-size: 16px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> action;
    callback acted();
    padding-left: 12px * Ui.k;
    Text {
        text: root.title;
        font-size: 36px * Ui.k;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    if root.action != "": Rectangle {
        width: label.preferred-width + 8px;
        label := Text {
            text: root.action;
            font-size: 24px * Ui.k;
            font-weight: 300;
            color: act.has-hover ? Theme.accent : Theme.faint;
            vertical-alignment: center;
        }
        act := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.acted(); }
        }
    }
}

// A row of cards that scrolls sideways, with the arrow of the layout.
component CardRow inherits Rectangle {
    in property <[Card]> cards;
    height: 300px * Ui.k;
    property <length> cell: 184px * Ui.k;
    flick := Flickable {
        width: max(1, floor((parent.width - 70px * Ui.k) / root.cell)) * root.cell;
        x: 0;
        content-width: row.preferred-width;
        interactive: true;
        row := HorizontalLayout {
            alignment: start;
            for c in root.cards: CardItem { card: c; }
        }
    }
    if root.cards.length > 3: Icon {
        x: parent.width - 67px * Ui.k;
        y: 80px * Ui.k;
        size: 67px * Ui.k;
        source: @image-url("icons/arrow-right.svg");
        // On to the next cards; from the last ones, back to the first.
        clicked => {
            if (flick.content-x <= flick.width - flick.content-width + 1px) {
                flick.content-x = 0;
            } else {
                flick.content-x = max(flick.width - flick.content-width, flick.content-x - flick.width);
            }
        }
    }
}

// A switch in the colors of the layout.
component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 52px * Ui.k;
    height: 28px * Ui.k;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.handle;
    animate background { duration: 150ms; }
    Rectangle {
        width: parent.height - 6px * Ui.k;
        height: self.width;
        border-radius: self.width / 2;
        y: 3px * Ui.k;
        x: root.on ? parent.width - self.width - 3px * Ui.k : 3px * Ui.k;
        background: #ffffff;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    callback clicked();
    height: 44px * Ui.k;
    width: label.preferred-width + 36px * Ui.k;
    border-radius: self.height / 2;
    background: strong ? (area.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : (area.has-hover ? Theme.hover : transparent);
    border-width: strong ? 0 : 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        font-size: 18px * Ui.k;
        color: root.strong ? #ffffff : Theme.text;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page that scrolls, with the scrollbar of the layout (a track with a rounded thumb).
component Page inherits Rectangle {
    in property <length> content-height;
    out property <length> scrolled: -flick.content-y;
    callback near-end();
    flick := Flickable {
        width: parent.width - 20px * Ui.k;
        height: parent.height;
        content-height: max(root.content-height, self.height);
        changed content-y => {
            if (-self.content-y + self.height > self.content-height - 400px) {
                root.near-end();
            }
        }
        @children
    }
    property <length> track: root.height;
    property <length> thumb: max(60px, track * min(1, flick.height / max(1px, flick.content-height)));
    Rectangle {
        x: parent.width - 20px * Ui.k;
        width: 20px * Ui.k;
        background: Theme.bar;
        visible: flick.content-height > flick.height + 1px;
        Rectangle {
            y: (root.track - root.thumb) * (-flick.content-y / max(1px, flick.content-height - flick.height));
            height: root.thumb;
            border-radius: 12px * Ui.k;
            border-width: 2px * Ui.k;
            border-color: Theme.bar;
            background: Theme.bg;
            TouchArea {
                property <length> start-y;
                property <length> start-view;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-view = flick.content-y;
                    }
                }
                moved => {
                    if (self.pressed) {
                        flick.content-y = max(flick.height - flick.content-height, min(0px,
                            self.start-view - (self.mouse-y - self.pressed-y) * (flick.content-height - flick.height) / max(1px, root.track - root.thumb)));
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- the playing song (left)

component Wave inherits Rectangle {
    // The bars of the layout; the played part in the warm gradient.
    property <float> played: App.duration > 0 ? App.position / App.duration : 0;
    property <int> count: App.wave.length;
    property <length> step: self.width / max(1, count);
    for h[i] in App.wave: Rectangle {
        x: i * root.step;
        width: root.step * 0.57;
        height: root.height * h;
        y: (root.height - self.height) / 2;
        property <float> at: (i + 0.5) / max(1, root.count);
        background: self.at <= root.played
            ? Theme.wave-from.mix(Theme.wave-to, 1 - self.at / max(0.01, root.played))
            : Theme.bar;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { App.seek(max(0, min(1, self.mouse-x / root.width)) * App.duration); }
        moved => {
            if (self.pressed) {
                App.seek(max(0, min(1, self.mouse-x / root.width)) * App.duration);
            }
        }
    }
}

component Volume inherits Rectangle {
    // The speaker on top, then the track: the level from the bottom in the accent color.
    Icon {
        x: 0;
        y: 0;
        size: 40px * Ui.k;
        source: App.volume > 0.01 ? @image-url("icons/volume-loud-bold.svg") : @image-url("icons/volume-cross-bold.svg");
        clicked => { App.set-volume(App.volume > 0.01 ? 0 : 0.8); }
    }
    property <length> top: 55px * Ui.k;
    property <length> bottom: root.height;
    property <length> span: bottom - top;
    Rectangle {
        x: 18px * Ui.k;
        y: root.top;
        width: 4px * Ui.k;
        height: root.span;
        border-radius: 2px * Ui.k;
        background: Theme.bar;
    }
    Rectangle {
        x: 18px * Ui.k;
        y: root.top + root.span * (1 - App.volume);
        width: 4px * Ui.k;
        height: root.span * App.volume;
        border-radius: 2px * Ui.k;
        background: Theme.accent;
    }
    Rectangle {
        width: 16px * Ui.k;
        height: self.width;
        border-radius: self.width / 2;
        x: 20px * Ui.k - self.width / 2;
        y: root.top + root.span * (1 - App.volume) - self.height / 2;
        background: Theme.handle;
        border-width: 2px * Ui.k;
        border-color: Theme.bar;
    }
    TouchArea {
        y: root.top - 10px;
        height: root.span + 20px;
        mouse-cursor: pointer;
        clicked => { App.set-volume(max(0, min(1, 1 - (self.mouse-y - 10px) / root.span))); }
        moved => {
            if (self.pressed) {
                App.set-volume(max(0, min(1, 1 - (self.mouse-y - 10px) / root.span)));
            }
        }
        scroll-event(e) => {
            App.set-volume(max(0, min(1, App.volume + (e.delta-y > 0 ? 0.05 : -0.05))));
            accept
        }
    }
}

component Lyrics inherits Rectangle {
    border-radius: 6px * Ui.k;
    background: Theme.dark ? #00000040 : #ffffff80;
    clip: true;
    property <length> line-h: App.lyrics-size * 1.9px * Ui.k;
    flick := Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding: 20px * Ui.k;
            spacing: 10px * Ui.k;
            if App.lyrics-note != "": Text {
                text: App.lyrics-note;
                font-size: 18px * Ui.k;
                color: Theme.dim;
                wrap: word-wrap;
            }
            for l[i] in App.lyrics: VerticalLayout {
                spacing: 2px * Ui.k;
                Text {
                    text: l.text;
                    font-size: App.lyrics-size * 1px * Ui.k;
                    font-weight: 700;
                    wrap: word-wrap;
                    color: l.state == 1 ? Theme.text : (l.state == 2 ? Theme.text.with-alpha(0.6) : Theme.text.with-alpha(0.32));
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.lyric-clicked(i); }
                    }
                }
                if l.tr != "": Text {
                    text: l.tr;
                    font-size: App.lyrics-size * 0.55px * Ui.k;
                    wrap: word-wrap;
                    color: Theme.dim.with-alpha(l.state == 1 ? 1 : 0.6);
                }
            }
        }
    }
    // Keep the sung line about a third of the way down.
    property <int> line: App.lyric-line;
    changed line => {
        if (self.line >= 0) {
            flick.content-y = max(flick.height - flick.content-height,
                min(0px, -(self.line * (root.line-h + 10px * Ui.k)) + flick.height / 3));
        }
    }
}

component NowPlaying inherits Rectangle {
    background: Theme.bg;
    border-top-right-radius: 34px * Ui.k;
    border-bottom-right-radius: 34px * Ui.k;
    clip: true;
    // The cover, blurred, behind it all.
    Image {
        width: 100%;
        height: 100%;
        source: App.backdrop;
        image-fit: cover;
        opacity: Theme.dark ? 0.16 : 0.3;
    }
    // RyM
    Text {
        x: 36px * Ui.k;
        y: 40px * Ui.k;
        text: "RyM";
        font-size: 34px * Ui.k;
        font-weight: 300;
        letter-spacing: 3px * Ui.k;
        color: Theme.text;
    }
    Text {
        x: 278px * Ui.k;
        y: 29px * Ui.k;
        width: 506px * Ui.k;
        height: 51px * Ui.k;
        text: App.tr("NOW PLAYING");
        font-family: "Chathura";
        font-size: 40px * Ui.k;
        letter-spacing: self.text == "NOW PLAYING" ? 37.6px * Ui.k : 0;
        horizontal-alignment: center;
        color: Theme.text;
    }
    Volume {
        x: 207px * Ui.k;
        y: 81px * Ui.k;
        width: 40px * Ui.k;
        height: 505px * Ui.k;
    }
    // The cover, or the lyrics in its place (the cover's button switches).
    if !App.show-lyrics: Cover {
        x: 278px * Ui.k;
        y: 80px * Ui.k;
        width: 506px * Ui.k;
        height: 506px * Ui.k;
        radius: 2px * Ui.k;
        source: App.cover;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { App.show-lyrics = true; }
        }
    }
    if App.show-lyrics: Lyrics {
        x: 278px * Ui.k;
        y: 80px * Ui.k;
        width: 506px * Ui.k;
        height: 506px * Ui.k;
    }
    Icon {
        x: 790px * Ui.k;
        y: 80px * Ui.k;
        size: 40px * Ui.k;
        source: @image-url("icons/text-square-bold.svg");
        tint: App.show-lyrics ? Theme.accent : Theme.icon;
        tip: App.tr("Lyrics");
        clicked => { App.show-lyrics = !App.show-lyrics; }
    }
    Icon {
        x: 790px * Ui.k;
        y: 130px * Ui.k;
        size: 40px * Ui.k;
        source: @image-url("icons/minimize-square-3-linear.svg");
        tip: App.tr("Mini player");
        clicked => { App.mini(); }
    }
    VerticalLayout {
        x: 278px * Ui.k;
        y: 610px * Ui.k;
        width: 420px * Ui.k;
        height: 120px * Ui.k;
        alignment: start;
        spacing: 14px * Ui.k;
        Text {
            text: App.has-song ? App.title : App.tr("Nothing playing");
            font-size: 48px * Ui.k;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            text: App.loading ? App.tr("Loading…") : App.artist;
            font-size: 24px * Ui.k;
            color: artist-area.has-hover ? Theme.accent : Theme.dim;
            overflow: elide;
            artist-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.open-artist(); }
            }
        }
    }
    Icon {
        x: 718px * Ui.k;
        y: 616px * Ui.k;
        size: 66px * Ui.k;
        source: App.liked ? @image-url("icons/heart-bold.svg") : @image-url("icons/heart-linear.svg");
        tint: Theme.accent;
        tip: App.tr("Like");
        clicked => { App.like-now(); }
    }
    Text {
        x: 210px * Ui.k;
        y: 784px * Ui.k;
        width: 64px * Ui.k;
        text: App.pos-text;
        font-size: 24px * Ui.k;
        color: Theme.dim;
        horizontal-alignment: right;
    }
    Wave {
        x: 285px * Ui.k;
        y: 776px * Ui.k;
        width: 495px * Ui.k;
        height: 43px * Ui.k;
    }
    Text {
        x: 794px * Ui.k;
        y: 784px * Ui.k;
        text: App.len-text;
        font-size: 24px * Ui.k;
        color: Theme.dim;
    }
    Icon {
        x: 234px * Ui.k;
        y: 880px * Ui.k;
        source: @image-url("icons/playlist.svg");
        tint: App.queue-open && App.page == 0 ? Theme.accent : Theme.icon;
        tip: App.tr("Up next");
        clicked => {
            App.go(0);
            App.queue-open = !App.queue-open;
        }
    }
    Icon {
        x: 352px * Ui.k;
        y: 883px * Ui.k;
        size: 56px * Ui.k;
        source: @image-url("icons/previous.svg");
        tip: App.tr("Previous");
        clicked => { App.previous(); }
    }
    Icon {
        x: 478px * Ui.k;
        y: 864px * Ui.k;
        size: 94px * Ui.k;
        source: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg");
        tip: App.tr("Play / pause");
        clicked => { App.toggle-play(); }
    }
    Icon {
        x: 642px * Ui.k;
        y: 883px * Ui.k;
        size: 56px * Ui.k;
        source: @image-url("icons/next.svg");
        tip: App.tr("Next");
        clicked => { App.next(); }
    }
    Icon {
        x: 767px * Ui.k;
        y: 882px * Ui.k;
        source: App.repeat-one ? @image-url("icons/repeat-one-linear.svg") : @image-url("icons/repeat.svg");
        tint: App.repeat-one ? Theme.accent : Theme.icon;
        tip: App.tr("Repeat this song");
        clicked => { App.repeat(); }
    }
    // The account: its picture, or the plain figure.
    Rectangle {
        x: 42px * Ui.k;
        y: 882px * Ui.k;
        width: 58px * Ui.k;
        height: 58px * Ui.k;
        border-radius: self.width / 2;
        clip: true;
        if App.has-avatar: Image {
            width: 100%;
            height: 100%;
            source: App.avatar;
            image-fit: cover;
        }
        if !App.has-avatar: Image {
            width: 100%;
            height: 100%;
            source: @image-url("icons/user.svg");
            colorize: Theme.icon;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { account.show(); }
        }
    }
    account := PopupWindow {
        x: 42px * Ui.k;
        y: 700px * Ui.k;
        width: 300px * Ui.k;
        Rectangle {
            background: Theme.raised;
            border-radius: 14px * Ui.k;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 18px * Ui.k;
                spacing: 12px * Ui.k;
                Text {
                    text: App.signed-in ? App.account-name : App.tr("Not signed in");
                    font-size: 22px * Ui.k;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                if App.account-handle != "": Text {
                    text: App.account-handle;
                    font-size: 16px * Ui.k;
                    color: Theme.dim;
                }
                Button {
                    text: App.signed-in ? App.tr("Sign out") : App.tr("Sign in with Google");
                    strong: !App.signed-in;
                    clicked => {
                        if (App.signed-in) {
                            App.sign-out();
                        } else {
                            App.sign-in();
                        }
                    }
                }
            }
        }
    }
}

// The rail of the layout: home, the playing song, search, library, settings.
component Rail inherits Rectangle {
    width: 140px * Ui.k;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border;
    border-top-right-radius: 34px * Ui.k;
    border-bottom-right-radius: 34px * Ui.k;
    VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-bottom: 48px * Ui.k;
        spacing: 46px * Ui.k;
        alignment: center;
        for item in [
            { page: 3, icon: @image-url("icons/home-2-bold.svg"), tip: "Home" },
            { page: 0, icon: @image-url("icons/nav-play.svg"), tip: "Now playing" },
            { page: 1, icon: @image-url("icons/nav-search.svg"), tip: "Search" },
            { page: 2, icon: @image-url("icons/nav-library.svg"), tip: "Library" },
            { page: 4, icon: @image-url("icons/settings-bold.svg"), tip: "Settings" },
        ]: HorizontalLayout {
            alignment: center;
            Icon {
                source: item.icon;
                tint: App.page == item.page || (item.page == 2 && App.page == 5) ? Theme.accent : Theme.icon;
                tip: App.tr(item.tip);
                clicked => { App.go(item.page); }
            }
        }
    }
}

// ---------------------------------------------------------------- the right side

component UpNext inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header {
            title: App.tr("Queue");
            action: App.queue-open ? App.tr("Less") : App.tr("Extend");
            acted => { App.queue-open = !App.queue-open; }
        }
        if App.queue.length == 0: Text {
            text: App.tr("Nothing is coming up");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            x: 12px * Ui.k;
        }
        VerticalLayout {
            spacing: 0;
            for s[i] in App.queue: SongRow {
                song: s;
                in-queue: true;
                visible: App.queue-open || i < 4;
                height: App.queue-open || i < 4 ? 106px * Ui.k : 0;
            }
        }
        Rectangle { height: 26px * Ui.k; }
        Header {
            title: App.tr("Similar songs");
            action: App.tr("See More");
            acted => { App.menu("similar-all", ""); }
        }
        CardRow { cards: App.similar; }
        Header {
            title: App.artist-name != "" ? App.tr("From the same artist") : "";
            action: App.artist-name != "" ? App.tr("See More") : "";
            acted => { App.open-artist(); }
        }
        CardRow { cards: App.same-artist; }
    }
}

component SearchPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header { title: App.tr("Search"); }
        Rectangle {
            height: 60px * Ui.k;
            border-radius: self.height / 2;
            background: Theme.raised;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            HorizontalLayout {
                padding-left: 22px * Ui.k;
                padding-right: 22px * Ui.k;
                spacing: 14px * Ui.k;
                Image {
                    width: 26px * Ui.k;
                    source: @image-url("icons/magnifer-linear.svg");
                    colorize: Theme.dim;
                }
                input := TextInput {
                    text <=> App.query;
                    font-size: 22px * Ui.k;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { App.typed(self.text); }
                    accepted => { App.search(self.text); }
                }
            }
        }
        // While typing: suggestions (the account's searches first, with a way to forget them).
        for g[i] in App.suggestions: Rectangle {
            height: 52px * Ui.k;
            border-radius: 10px * Ui.k;
            background: pick.has-hover ? Theme.hover : transparent;
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.pick-suggestion(i); }
            }
            HorizontalLayout {
                padding-left: 22px * Ui.k;
                padding-right: 12px * Ui.k;
                spacing: 14px * Ui.k;
                Image {
                    width: 22px * Ui.k;
                    source: g.history ? @image-url("icons/history-linear.svg") : @image-url("icons/magnifer-linear.svg");
                    colorize: Theme.dim;
                }
                Text {
                    text: g.text;
                    font-size: 20px * Ui.k;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if g.history: Icon {
                    size: 34px * Ui.k;
                    source: @image-url("icons/close-circle-linear.svg");
                    tip: App.tr("Remove from search history");
                    clicked => { App.forget-suggestion(i); }
                }
            }
        }
        if App.searching: Text {
            text: App.tr("Searching…");
            font-size: 20px * Ui.k;
            color: Theme.dim;
        }
        for s in App.results: SongRow { song: s; handle: false; }
    }
}

component Grid inherits Rectangle {
    // Cards in rows that fit the width.
    in property <[Card]> cards;
    property <length> cell: 184px * Ui.k;
    property <int> per-row: max(1, floor(self.width / cell));
    height: ceil(cards.length / per-row) * 260px * Ui.k;
    for c[i] in root.cards: CardItem {
        x: mod(i, root.per-row) * root.cell;
        y: floor(i / root.per-row) * 260px * Ui.k;
        card: c;
    }
}

component LibraryPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header { title: App.tr("Library"); }
        if !App.signed-in: VerticalLayout {
            spacing: 18px * Ui.k;
            padding-left: 12px * Ui.k;
            Text {
                text: App.tr("Sign in to see your liked songs and playlists");
                font-size: 20px * Ui.k;
                color: Theme.dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: App.tr("Sign in with Google");
                    strong: true;
                    clicked => { App.sign-in(); }
                }
            }
        }
        Grid { cards: App.playlists; }
    }
}

component HomePage inherits Page {
    content-height: col.preferred-height;
    near-end => { App.more(); }
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 10px * Ui.k;
        Header {
            title: App.tr("Home");
            action: App.home-loading ? App.tr("Refreshing…") : App.tr("Refresh");
            acted => { App.refresh-home(); }
        }
        if App.home.length == 0: Text {
            text: App.home-loading ? App.tr("Loading your feed…") : App.tr("Nothing here yet");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            x: 12px * Ui.k;
        }
        for shelf in App.home: VerticalLayout {
            spacing: 6px * Ui.k;
            Header { title: shelf.title; }
            CardRow { cards: shelf.cards; }
        }
    }
}

component ListPage inherits Page {
    content-height: col.preferred-height;
    near-end => {
        if (App.list-more) {
            App.more();
        }
    }
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header {
            title: App.list-title;
            action: App.list.length > 0 ? App.tr("Play all") : "";
            acted => { App.play-all(); }
        }
        if App.list-loading && App.list.length == 0: Text {
            text: App.tr("Loading…");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            x: 12px * Ui.k;
        }
        for s in App.list: SongRow { song: s; handle: false; }
    }
}

component SettingsPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-right: 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 18px * Ui.k;
        Header { title: App.tr("Settings"); }
        for t in App.toggles: HorizontalLayout {
            padding-left: 12px * Ui.k;
            spacing: 20px * Ui.k;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px * Ui.k;
                Text {
                    text: t.title;
                    font-size: 22px * Ui.k;
                    font-weight: 700;
                    color: Theme.text;
                }
                if t.about != "": Text {
                    text: t.about;
                    font-size: 16px * Ui.k;
                    color: Theme.dim;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    on: t.on;
                    toggled(v) => { App.set-toggle(t.id, v); }
                }
            }
        }
        for n in [
            { id: "crossfade", title: "Crossfade", unit: "s", low: 0, high: 12 },
            { id: "lyrics-size", title: "Lyrics size", unit: "px", low: 14, high: 48 },
        ]: HorizontalLayout {
            padding-left: 12px * Ui.k;
            spacing: 14px * Ui.k;
            property <int> value: n.id == "crossfade" ? App.crossfade : App.lyrics-size;
            Text {
                text: App.tr(n.title);
                font-size: 22px * Ui.k;
                font-weight: 700;
                color: Theme.text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Icon {
                size: 36px * Ui.k;
                source: @image-url("icons/alt-arrow-left-linear.svg");
                clicked => { App.set-number(n.id, max(n.low, parent.value - 1)); }
            }
            Text {
                text: parent.value + " " + n.unit;
                font-size: 20px * Ui.k;
                color: Theme.text;
                vertical-alignment: center;
                min-width: 70px * Ui.k;
                horizontal-alignment: center;
            }
            Icon {
                size: 36px * Ui.k;
                source: @image-url("icons/alt-arrow-right-linear.svg");
                clicked => { App.set-number(n.id, min(n.high, parent.value + 1)); }
            }
        }
        HorizontalLayout {
            padding-left: 12px * Ui.k;
            spacing: 14px * Ui.k;
            alignment: start;
            Button {
                text: App.tr("Check for updates");
                clicked => { App.check-updates(); }
            }
            Text {
                text: App.update-text;
                font-size: 18px * Ui.k;
                color: Theme.dim;
                vertical-alignment: center;
            }
        }
        Text {
            x: 12px * Ui.k;
            text: "RyM " + App.version;
            font-size: 16px * Ui.k;
            color: Theme.dim;
        }
        HorizontalLayout {
            alignment: start;
            padding-left: 12px * Ui.k;
            AboutSlint {
                max-height: 200px;
            }
        }
    }
}

// ---------------------------------------------------------------- the window

export component AppWindow inherits Window {
    title: App.has-song ? App.title + " · " + App.artist + " — RyM" : "RyM";
    icon: @image-url("../assets/icons/rym-gui.png");
    preferred-width: 1360px;
    preferred-height: 870px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Roboto";
    property <float> scale: max(0.5, min(1.4, min(self.width / 1600px, self.height / 1024px)));
    changed scale => { Ui.k = self.scale; }
    init => { Ui.k = self.scale; }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == " " && App.page != 1) {
                App.toggle-play();
                return accept;
            }
            reject
        }
    }

    NowPlaying {
        x: 0;
        y: 0;
        width: 872px * Ui.k;
        height: max(root.height, 1024px * Ui.k);
    }
    Rail {
        x: 0;
        y: (root.height - self.height) / 2;
        height: 580px * Ui.k;
    }
    Rectangle {
        x: 900px * Ui.k;
        y: 0;
        width: root.width - self.x;
        height: root.height;
        if App.page == 0: UpNext { width: 100%; height: 100%; }
        if App.page == 1: SearchPage { width: 100%; height: 100%; }
        if App.page == 2: LibraryPage { width: 100%; height: 100%; }
        if App.page == 3: HomePage { width: 100%; height: 100%; }
        if App.page == 4: SettingsPage { width: 100%; height: 100%; }
        if App.page == 5: ListPage { width: 100%; height: 100%; }
    }
    // A short notice at the bottom.
    if App.toast != "": Rectangle {
        y: root.height - 90px;
        x: (root.width - self.width) / 2;
        width: min(root.width - 40px, note.preferred-width + 48px);
        height: 48px;
        border-radius: 24px;
        background: Theme.dark ? #1d1c28ee : #222222ee;
        note := Text {
            text: App.toast;
            font-size: 16px;
            color: #ffffff;
            overflow: elide;
        }
    }
}

// The mini player: cover, song, previous / play / next, above the other windows.
export component MiniWindow inherits Window {
    title: "RyM mini player";
    icon: @image-url("../assets/icons/rym-gui.png");
    width: 420px;
    height: 96px;
    no-frame: true;
    always-on-top: true;
    background: Theme.bg;
    default-font-family: "Roboto";
    callback hide-mini();
    callback drag(length, length);
    Rectangle {
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 76px;
            border-radius: 8px;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: App.cover;
                image-fit: cover;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: App.has-song ? App.title : App.tr("Nothing playing");
                font-size: 17px;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: App.artist;
                font-size: 14px;
                color: Theme.dim;
                overflow: elide;
            }
        }
        for b in [
            { id: 0, icon: @image-url("icons/previous.svg"), size: 34px, turn: 0deg },
            { id: 1, icon: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg"), size: 46px, turn: 0deg },
            { id: 2, icon: @image-url("icons/next.svg"), size: 34px, turn: 0deg },
            { id: 3, icon: @image-url("icons/close-circle-linear.svg"), size: 28px, turn: 0deg },
        ]: VerticalLayout {
            alignment: center;
            Icon {
                size: b.size;
                source: b.icon;
                turn: b.turn;
                clicked => {
                    if (b.id == 0) { App.previous(); }
                    if (b.id == 1) { App.toggle-play(); }
                    if (b.id == 2) { App.next(); }
                    if (b.id == 3) { root.hide-mini(); }
                }
            }
        }
    }
}
