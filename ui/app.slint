// RyM Slint: the window app, in two layouts.
// - RyM Dusk / RyM Mist (dark / light): the playing song on the left (big cover, wave progress,
//   volume, controls) and on the right Up next, similar songs and the artist's songs, or the page
//   picked in the rail. Sizes follow a 1600 x 1024 layout and scale with the window (Ui.k).
// - RyM Wide: a search bar on top, the pages listed on the side, the playing song like a watch
//   page (the big picture with Up next beside it), and a player bar at the bottom elsewhere.
// Arabic turns the layout around (Ui.rtl).

import "fonts/Roboto-Regular.ttf";
import "fonts/Roboto-Bold.ttf";
import "fonts/Roboto-Light.ttf";
import "fonts/Chathura-Regular.ttf";
import "fonts/Doto.ttf";
import { AboutSlint } from "std-widgets.slint";

export struct Song {
    key: string,
    title: string,
    artist: string,
    cover: image,
    liked: bool,
    playing: bool,
}

export struct Card {
    key: string,
    title: string,
    sub: string,
    cover: image,
}

export struct Shelf {
    title: string,
    cards: [Card],
}

export struct LyricLine {
    text: string,
    tr: string,
    ro: string,
    // Written right to left (Arabic): it lines up on the right and fills from the right.
    rtl: bool,
    // 0 to come, 1 sung now, 2 sung
    state: int,
}

export struct Suggest {
    text: string,
    history: bool,
}

// A row of the settings: 0 a switch, 1 a choice (< value >), 2 a text box, 3 a button, 4 a heading.
export struct Setting {
    id: string,
    kind: int,
    title: string,
    about: string,
    on: bool,
    value: string,
}

// A bar of the stats page: its name, its length (0 to 1) and what it says.
export struct Bar {
    label: string,
    value: float,
    text: string,
}

// 0 RyM Dusk, 1 RyM Mist, 2 RyM Wide.
// A color theme (Settings > Colors, or a .json file): its colors and its style.
export struct Pal {
    dark: bool,
    bg: color,
    raised: color,
    text: color,
    dim: color,
    icon: color,
    accent: color,
    accent2: color,
    bar: color,
    border: color,
    round: float,
    glow: bool,
    cover-border: bool,
    glass: float,
    dot-clock: bool,
    vu: bool,
    rain: bool,
    pattern: image,
}

export global Theme {
    in-out property <int> index: 0;
    // A color theme over the layout's own colors.
    in-out property <bool> custom: false;
    in-out property <Pal> p;
    out property <bool> dark: custom ? p.dark : index != 1;
    out property <bool> wide: index == 2;
    out property <float> round: custom ? p.round : 1;
    out property <bool> glow: custom && p.glow;
    out property <float> glass: custom ? p.glass : 0;
    out property <bool> vu: custom && p.vu;
    out property <bool> rain: custom && p.rain;
    out property <bool> cover-border: custom && p.cover-border;
    out property <bool> has-pattern: custom && p.pattern.width > 0;
    out property <string> clock-font: custom && p.dot-clock ? "Doto" : "Roboto";
    // Liquid Aurora: the cover's four colors, moving with the bass (0 to 1).
    in-out property <bool> aurora: false;
    in-out property <color> a1: #ea814a;
    in-out property <color> a2: #8e44ad;
    in-out property <color> a3: #2980b9;
    in-out property <color> a4: #16a085;
    in-out property <float> energy: 0;
    // The cover as a record, and how fast it turns (degrees a second).
    in-out property <bool> vinyl: false;
    in-out property <float> spin-rate: 200;
    // The needle meters' left and right (0 to 1).
    in-out property <float> vu-l: 0;
    in-out property <float> vu-r: 0;
    // The accent from the playing song's cover (Settings), when on.
    in-out property <bool> cover-accent: false;
    in-out property <color> cover-color: #ea814a;
    out property <color> bg: custom ? p.bg : (index == 1 ? #e8e8e8 : (index == 2 ? #0f0f0f : #343345));
    out property <color> raised: custom ? p.raised : (index == 1 ? #f4f4f4 : (index == 2 ? #272727 : #3d3c50));
    out property <color> text: custom ? p.text : (index == 1 ? #111111 : (index == 2 ? #f1f1f1 : #ffffff));
    out property <color> dim: custom ? p.dim : (index == 1 ? #4d4d55 : (index == 2 ? #aaaaaa : #c6c6c6));
    out property <color> faint: custom ? p.dim : (index == 1 ? #5a5a62 : (index == 2 ? #9a9a9a : #d5d5d5));
    out property <color> icon: custom ? p.icon : (index == 1 ? #3c3b4a : (index == 2 ? #f1f1f1 : #e4e3e3));
    out property <color> handle: custom ? p.dim.with-alpha(0.7) : (index == 2 ? #717171 : #666477);
    out property <color> accent: cover-accent ? cover-color : (custom ? p.accent : (index == 2 ? #ff4e45 : #ea814a));
    out property <color> bar: custom ? p.bar : (index == 1 ? #b4b3bd : (index == 2 ? #3f3f3f : #d9d9d9));
    out property <color> border: cover-border ? cover-color.with-alpha(0.85) : (custom ? p.border : (index == 2 ? #3f3f3f : #666477.with-alpha(0.5)));
    out property <color> hover: dark ? #ffffff14 : #0000000d;
    out property <color> wave-from: cover-accent ? cover-color.brighter(0.5) : (custom ? p.accent2 : (index == 2 ? #ff8a80 : #f9d19e));
    out property <color> wave-to: cover-accent ? cover-color : (custom ? p.accent : (index == 2 ? #ff0033 : #d53a0c));
}

// The scale of the 1600 x 1024 layout to the window, the size picked in the app, and Arabic.
export global Ui {
    in-out property <float> k: 1;
    in-out property <float> zoom: 0.85;
    in-out property <bool> rtl: false;
    out property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
}

export global App {
    pure callback tr(string) -> string;

    // ---- the playing song
    in property <bool> has-song;
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <image> backdrop;
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> liked;
    in property <float> position;
    in property <float> duration;
    in property <string> pos-text: "0:00";
    in property <string> len-text: "0:00";
    in property <[float]> wave;
    in-out property <float> volume: 0.8;
    in property <bool> repeat-one;
    // Repeat all: the list starts over when it ends (every time).
    in property <bool> repeat-all;
    in-out property <bool> show-lyrics;
    in property <[LyricLine]> lyrics;
    in property <string> lyrics-note;
    in property <int> lyric-line: -1;
    // How far into the sung line (0 to 1), for the karaoke.
    in property <float> line-progress;
    in property <bool> karaoke: true;
    in-out property <int> lyrics-size: 25;
    // The lyrics' sources (LRCLIB, NetEase...) and the one shown.
    in property <[string]> sources;
    in property <int> source-at: -1;
    in property <string> sleep-text;
    // The playing speed as the button by the heart shows it ("1×", "Nightcore").
    in property <string> speed-text: "1×";

    // ---- the pages
    // 0 now playing (Up next), 1 search, 2 library, 3 home, 4 settings, 5 a list, 6 stats
    in-out property <int> page: 0;
    in property <[Song]> queue;
    in-out property <bool> queue-open;
    in property <[Card]> similar;
    in property <[Card]> same-artist;
    in property <string> artist-name;
    in property <[Shelf]> home;
    in property <bool> home-loading;
    in property <[Song]> list;
    in property <string> list-title;
    in property <bool> list-loading;
    in property <bool> list-more;
    in property <[Card]> playlists;
    in property <[Suggest]> suggestions;
    in-out property <string> query;
    in property <[Song]> results;
    in property <bool> searching;
    in property <[Bar]> top-artists;
    in property <[Bar]> top-songs;
    in property <[Bar]> kinds;
    in property <string> stats-text;

    // ---- account, settings, notices
    in property <bool> signed-in;
    in property <string> account-name;
    in property <string> account-handle;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <[Setting]> settings;
    in property <string> version;
    in property <string> toast;
    // The X was pressed: close RyM, or keep it playing in the background?
    in-out property <bool> close-ask;
    // The library's playlists (Save to playlist), and the plugins in use.
    in property <[string]> playlist-names;
    in property <bool> has-video;
    in property <bool> has-soundcloud;
    // Search on YouTube Music (0) or SoundCloud (1).
    in-out property <int> search-in: 0;
    // A question with a text box (a playlist's name, a link): its title and what's typed.
    in-out property <bool> prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-hint;
    in-out property <string> prompt-text;
    // Seamless Music, asked first: what plays on the phone.
    in-out property <bool> peer-ask;
    in property <string> peer-text;

    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback like-now();
    callback repeat();
    callback go(int);
    callback play(string);
    callback menu(string, string);
    callback move-queue(string, int);
    callback open-card(string);
    callback search(string);
    callback typed(string);
    callback pick-suggestion(int);
    callback forget-suggestion(int);
    callback refresh-home();
    callback more();
    callback play-all();
    callback lyric-clicked(int);
    callback pick-source(int);
    callback set-toggle(string, bool);
    callback choose(string, int);
    callback set-text(string, string);
    callback press(string);
    callback sign-in();
    callback sign-out();
    callback open-artist();
    callback mini();
    callback float-lyrics();
    callback share();
    callback zoom(float);
    callback next-theme();
    callback set-speed(string);
    callback close-choice(bool, bool);
    callback prompt-done(bool);
    callback peer-choice(bool);
}

// ---------------------------------------------------------------- small parts

component Icon inherits Rectangle {
    in property <image> source;
    in property <length> size: 48px * Ui.k;
    in property <color> tint: Theme.icon;
    in property <string> tip;
    callback clicked();
    width: size;
    height: size;
    background: area.has-hover ? Theme.hover : transparent;
    border-radius: (size / 4) * Theme.round;
    Image {
        width: parent.size * 0.86;
        height: parent.size * 0.86;
        source: root.source;
        colorize: root.tint;
        image-fit: contain;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: 6px * Ui.k;
    border-radius: (radius) * Theme.round;
    clip: true;
    background: Theme.raised;
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
}

// Liquid Aurora: the cover's four colors as soft lights, bigger and brighter with the bass.
component Aurora inherits Rectangle {
    property <float> e: Theme.energy;
    animate e { duration: 140ms; easing: ease-out; }
    // A slow drift while music plays (still when paused: nothing is redrawn then).
    property <float> t: App.playing ? animation-tick() / 1ms / 6000 : 0;
    for blob[i] in [
        { c: Theme.a1, x: 0.18, y: 0.22, s: 0.8 },
        { c: Theme.a2, x: 0.84, y: 0.2, s: 0.7 },
        { c: Theme.a3, x: 0.28, y: 0.86, s: 0.75 },
        { c: Theme.a4, x: 0.82, y: 0.8, s: 0.65 },
    ]: Rectangle {
        property <length> size: min(root.width, root.height) * blob.s * (1 + root.e * 0.4);
        x: root.width * (blob.x + Math.sin((root.t + i * 1.7) * 1rad) * 0.05) - self.size / 2;
        y: root.height * (blob.y + Math.cos((root.t * 0.8 + i * 2.3) * 1rad) * 0.05) - self.size / 2;
        width: self.size;
        height: self.size;
        background: @radial-gradient(circle, blob.c.with-alpha(Theme.dark ? 0.5 : 0.4) 0%, blob.c.with-alpha(0) 70%);
        opacity: 0.55 + root.e * 0.45;
    }
}

// Behind everything: the cover through frosted glass, Liquid Aurora, and the theme's pattern.
component Backdrop inherits Rectangle {
    if Theme.glass > 0: Image {
        width: 100%;
        height: 100%;
        source: App.backdrop;
        image-fit: cover;
        opacity: 0.3 + Theme.glass * 0.6;
    }
    if Theme.aurora: Aurora {
        width: 100%;
        height: 100%;
    }
    if Theme.has-pattern: Image {
        property <length> tile: Theme.p.pattern.height * 1px;
        // Rain runs down; the other patterns stay.
        y: Theme.rain && App.playing ? Math.mod(animation-tick() / 1ms * 0.09, Theme.p.pattern.height) * 1px - self.tile : 0;
        width: 100%;
        height: parent.height + self.tile;
        source: Theme.p.pattern;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
}

// The cover as a record: grooves, the cover as its label, turning while it plays (faster with
// Nightcore, slower with Slowed).
component Vinyl inherits Rectangle {
    in property <image> source;
    property <float> rate: Theme.spin-rate;
    property <bool> spinning: App.playing && !App.loading;
    property <float> base: 0;
    property <duration> from: 0ms;
    property <float> turn: spinning ? base + (animation-tick() - from) / 1s * rate : base;
    changed spinning => {
        if (spinning) {
            from = animation-tick();
        } else {
            base = Math.mod(base + (animation-tick() - from) / 1s * rate, 360);
        }
    }
    changed rate => {
        if (spinning) {
            base = Math.mod(base + (animation-tick() - from) / 1s * rate, 360);
            from = animation-tick();
        }
    }
    disc := Rectangle {
        width: min(parent.width, parent.height);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: #0c0c0d;
        drop-shadow-blur: 26px * Ui.k;
        drop-shadow-color: Theme.glow ? Theme.accent.with-alpha(0.6) : #00000088;
        for i in 10: Rectangle {
            width: disc.width * (0.97 - i * 0.052);
            height: self.width;
            x: (disc.width - self.width) / 2;
            y: (disc.height - self.height) / 2;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: Math.mod(i, 3) == 0 ? #ffffff22 : #ffffff0e;
        }
        Rectangle {
            width: disc.width * 0.4;
            height: self.width;
            x: (disc.width - self.width) / 2;
            y: (disc.height - self.height) / 2;
            border-radius: self.width / 2;
            clip: true;
            background: Theme.accent;
            Image {
                width: 100%;
                height: 100%;
                source: root.source;
                image-fit: cover;
                transform-rotation: root.turn * 1deg;
            }
        }
        Rectangle {
            width: disc.width * 0.035;
            height: self.width;
            x: (disc.width - self.width) / 2;
            y: (disc.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Theme.bg;
        }
    }
    // The light on it stays still while it turns.
    Rectangle {
        x: disc.x;
        y: disc.y;
        width: disc.width;
        height: disc.height;
        border-radius: self.width / 2;
        background: @linear-gradient(135deg, #ffffff00 28%, #ffffff18 46%, #ffffff00 55%, #ffffff00 70%, #ffffff0c 82%, #ffffff00 90%);
    }
}

// A needle meter (Hi-Fi Rack): the level in VU, the needle easing after it.
component VuMeter inherits Rectangle {
    in property <float> level;
    in property <string> label;
    property <float> l: level;
    animate l { duration: 90ms; easing: ease-out; }
    border-radius: 6px * Ui.k * Theme.round;
    border-width: 2px * Ui.k;
    border-color: #0d0d0d;
    background: @linear-gradient(180deg, #f4ecd4 0%, #ddd0ad 100%);
    clip: true;
    for i in 11: Rectangle {
        property <angle> a: -50deg + i * 10deg;
        width: 2px * Ui.k;
        height: (i >= 8 ? 11px : 7px) * Ui.k;
        x: root.width / 2 + Math.sin(self.a) * root.height * 0.8 - self.width / 2;
        y: root.height * 0.96 - Math.cos(self.a) * root.height * 0.8 - self.height / 2;
        transform-rotation: self.a;
        background: i >= 8 ? #c0392b : #2b2b2b;
    }
    Text {
        y: root.height * 0.42;
        width: root.width;
        horizontal-alignment: center;
        text: "VU";
        font-size: 12px * Ui.k;
        font-weight: 700;
        color: #2b2b2b;
    }
    Text {
        x: 8px * Ui.k;
        y: root.height - 18px * Ui.k;
        text: root.label;
        font-size: 11px * Ui.k;
        color: #5a5a5a;
    }
    Rectangle {
        width: 2px * Ui.k;
        height: root.height * 0.86;
        x: root.width / 2 - self.width / 2;
        y: root.height * 0.96 - self.height;
        background: #161616;
        transform-origin: { x: self.width / 2, y: self.height };
        transform-rotation: -50deg + root.l * 100deg;
    }
    Rectangle {
        width: 10px * Ui.k;
        height: self.width;
        x: root.width / 2 - self.width / 2;
        y: root.height * 0.96 - self.height / 2;
        border-radius: self.width / 2;
        background: #161616;
    }
}

// A song in a list: cover, title, artist (and the drag handle in Up next).
component SongRow inherits Rectangle {
    in property <Song> song;
    in property <bool> handle: true;
    in property <bool> in-queue;
    in property <length> cover-size: 82px * Ui.k;
    in property <length> title-size: 24px * Ui.k;
    // Dragged by the handle: how many rows it moved.
    property <length> row-h: self.height;
    property <length> dragged: 0;
    height: cover-size + 24px * Ui.k;
    border-radius: (8px * Ui.k) * Theme.round;
    background: dragged != 0 ? Theme.accent.with-alpha(0.25) : (song.playing || area.has-hover ? Theme.hover : transparent);
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.play(root.song.key); }
    }
    ContextMenuArea {
        Menu {
            MenuItem { title: App.tr("Play next"); activated => { App.menu("next", root.song.key); } }
            MenuItem { title: App.tr("Add to queue"); activated => { App.menu("add", root.song.key); } }
            MenuItem { title: App.tr("Start radio"); activated => { App.menu("radio", root.song.key); } }
            Menu {
                title: App.tr("Save to playlist");
                for name[pi] in App.playlist-names: MenuItem { title: name; activated => { App.menu("save:" + pi, root.song.key); } }
            }
            MenuItem { title: App.tr("Go to album"); activated => { App.menu("album", root.song.key); } }
            MenuItem { title: App.tr("Watch video"); enabled: App.has-video; activated => { App.menu("video", root.song.key); } }
            MenuItem { title: App.tr("Download video"); enabled: App.has-video; activated => { App.menu("video-dl", root.song.key); } }
            MenuItem { title: App.tr("Recommend more"); activated => { App.menu("more", root.song.key); } }
            MenuItem { title: App.tr("Don't recommend"); activated => { App.menu("less", root.song.key); } }
            MenuItem { title: root.song.liked ? App.tr("Remove from liked songs") : App.tr("Add to liked songs"); activated => { App.menu("like", root.song.key); } }
            MenuItem { title: App.tr("Go to artist"); activated => { App.menu("artist", root.song.key); } }
            Menu {
                title: App.tr("This artist's kind");
                MenuItem { title: App.tr("Songs"); activated => { App.menu("kind:Songs", root.song.key); } }
                MenuItem { title: App.tr("Husseini"); activated => { App.menu("kind:Husseini", root.song.key); } }
                MenuItem { title: App.tr("Quran"); activated => { App.menu("kind:Quran", root.song.key); } }
                MenuItem { title: App.tr("Nasheeds"); activated => { App.menu("kind:Nasheeds", root.song.key); } }
                MenuItem { title: App.tr("Talks"); activated => { App.menu("kind:Talks", root.song.key); } }
            }
            MenuItem { title: App.tr("Download"); activated => { App.menu("download", root.song.key); } }
            MenuItem { title: App.tr("Copy link"); activated => { App.menu("share", root.song.key); } }
            MenuItem { title: App.tr("Remove from queue"); enabled: root.in-queue; activated => { App.menu("remove", root.song.key); } }
        }
    }
    HorizontalLayout {
        padding: 12px * Ui.k;
        spacing: 24px * Ui.k;
        if Ui.rtl && root.handle: grip-r := VerticalLayout {
            alignment: center;
            spacing: 4px * Ui.k;
            width: 21px * Ui.k;
            for i in 3: Rectangle { height: 2px * Ui.k; background: Theme.handle; }
        }
        if Ui.rtl: names-r := VerticalLayout {
            alignment: center;
            spacing: 12px * Ui.k;
            Text { text: root.song.title; font-size: root.title-size; font-weight: 700; color: root.song.playing ? Theme.accent : Theme.text; overflow: elide; horizontal-alignment: right; }
            Text { text: root.song.artist; font-size: 16px * Ui.k; color: Theme.dim; overflow: elide; horizontal-alignment: right; }
        }
        Cover {
            width: root.cover-size;
            height: root.cover-size;
            source: root.song.cover;
        }
        if !Ui.rtl: VerticalLayout {
            alignment: center;
            spacing: 12px * Ui.k;
            Text { text: root.song.title; font-size: root.title-size; font-weight: 700; color: root.song.playing ? Theme.accent : Theme.text; overflow: elide; }
            Text { text: root.song.artist; font-size: 16px * Ui.k; color: Theme.dim; overflow: elide; }
        }
        if !Ui.rtl && root.handle: Rectangle {
            width: 28px * Ui.k;
            VerticalLayout {
                alignment: center;
                spacing: 4px * Ui.k;
                for i in 3: Rectangle { height: 2px * Ui.k; background: grip.pressed ? Theme.accent : Theme.handle; }
            }
            grip := TouchArea {
                mouse-cursor: move;
                moved => {
                    if (self.pressed) {
                        root.dragged = self.mouse-y - self.pressed-y;
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up) {
                        if (root.dragged != 0) {
                            App.move-queue(root.song.key, round(root.dragged / root.row-h));
                        }
                        root.dragged = 0;
                    }
                }
            }
        }
    }
}

// A cover with its name under it (similar songs, the artist's songs, home shelves).
component CardItem inherits VerticalLayout {
    in property <Card> card;
    in property <length> size: 160px * Ui.k;
    padding: 12px * Ui.k;
    spacing: 18px * Ui.k;
    width: size + 24px * Ui.k;
    Rectangle {
        width: root.size;
        height: root.size;
        Cover {
            width: 100%;
            height: 100%;
            radius: Theme.wide ? 12px * Ui.k : 6px * Ui.k;
            source: root.card.cover;
        }
        Rectangle {
            border-radius: (6px * Ui.k) * Theme.round;
            background: area.has-hover ? #00000030 : transparent;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.open-card(root.card.key); }
        }
        ContextMenuArea {
            Menu {
                MenuItem { title: App.tr("Play next"); activated => { App.menu("next", root.card.key); } }
                MenuItem { title: App.tr("Add to queue"); activated => { App.menu("add", root.card.key); } }
                MenuItem { title: App.tr("Start radio"); activated => { App.menu("radio", root.card.key); } }
                Menu {
                    title: App.tr("Save to playlist");
                    for name[pi] in App.playlist-names: MenuItem { title: name; activated => { App.menu("save:" + pi, root.card.key); } }
                }
                MenuItem { title: App.tr("Go to album"); activated => { App.menu("album", root.card.key); } }
                MenuItem { title: App.tr("Watch video"); enabled: App.has-video; activated => { App.menu("video", root.card.key); } }
                MenuItem { title: App.tr("Download video"); enabled: App.has-video; activated => { App.menu("video-dl", root.card.key); } }
                MenuItem { title: App.tr("Recommend more"); activated => { App.menu("more", root.card.key); } }
                MenuItem { title: App.tr("Don't recommend"); activated => { App.menu("less", root.card.key); } }
                MenuItem { title: false ? App.tr("Remove from liked songs") : App.tr("Add to liked songs"); activated => { App.menu("like", root.card.key); } }
                MenuItem { title: App.tr("Go to artist"); activated => { App.menu("artist", root.card.key); } }
                Menu {
                    title: App.tr("This artist's kind");
                    MenuItem { title: App.tr("Songs"); activated => { App.menu("kind:Songs", root.card.key); } }
                    MenuItem { title: App.tr("Husseini"); activated => { App.menu("kind:Husseini", root.card.key); } }
                    MenuItem { title: App.tr("Quran"); activated => { App.menu("kind:Quran", root.card.key); } }
                    MenuItem { title: App.tr("Nasheeds"); activated => { App.menu("kind:Nasheeds", root.card.key); } }
                    MenuItem { title: App.tr("Talks"); activated => { App.menu("kind:Talks", root.card.key); } }
                }
                MenuItem { title: App.tr("Download"); activated => { App.menu("download", root.card.key); } }
                MenuItem { title: App.tr("Copy link"); activated => { App.menu("share", root.card.key); } }
            }
        }
    }
    VerticalLayout {
        spacing: 10px * Ui.k;
        Text {
            text: root.card.title;
            font-size: Theme.wide ? 20px * Ui.k : 24px * Ui.k;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: Theme.wide ? Ui.start : center;
            overflow: elide;
        }
        Text {
            text: root.card.sub;
            font-size: 16px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Theme.wide ? Ui.start : center;
            overflow: elide;
        }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    in property <string> action;
    in property <string> action2;
    callback acted();
    callback acted2();
    height: max(heading.preferred-height, 40px * Ui.k);
    heading := Text {
        x: Ui.rtl ? parent.width - self.width - 12px * Ui.k : 12px * Ui.k;
        width: parent.width - 12px * Ui.k - acts.preferred-width - 12px;
        text: root.title;
        font-size: Theme.wide ? 30px * Ui.k : 36px * Ui.k;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: Ui.start;
        vertical-alignment: center;
        overflow: elide;
    }
    acts := HorizontalLayout {
        x: Ui.rtl ? 0 : parent.width - self.preferred-width;
        width: self.preferred-width;
        spacing: 18px * Ui.k;
        if root.action2 != "": Rectangle {
            width: label2.preferred-width + 8px;
            label2 := Text { text: root.action2; font-size: 22px * Ui.k; font-weight: 300; color: act2.has-hover ? Theme.accent : Theme.faint; vertical-alignment: center; }
            act2 := TouchArea { mouse-cursor: pointer; clicked => { root.acted2(); } }
        }
        if root.action != "": Rectangle {
            width: label.preferred-width + 8px;
            label := Text { text: root.action; font-size: 24px * Ui.k; font-weight: 300; color: act.has-hover ? Theme.accent : Theme.faint; vertical-alignment: center; }
            act := TouchArea { mouse-cursor: pointer; clicked => { root.acted(); } }
        }
    }
}

// A row of cards that scrolls sideways, with the arrow of the layout.
component CardRow inherits Rectangle {
    in property <[Card]> cards;
    height: 300px * Ui.k;
    property <length> cell: 184px * Ui.k;
    flick := Flickable {
        width: max(1, floor((parent.width - 70px * Ui.k) / root.cell)) * root.cell;
        x: Ui.rtl ? parent.width - self.width : 0;
        content-width: row.preferred-width;
        interactive: true;
        row := HorizontalLayout {
            alignment: start;
            for c in root.cards: CardItem { card: c; }
        }
    }
    if root.cards.length > 3: Icon {
        x: Ui.rtl ? 0 : parent.width - 67px * Ui.k;
        y: 80px * Ui.k;
        size: 67px * Ui.k;
        source: @image-url("icons/arrow-right.svg");
        // On to the next cards; from the last ones, back to the first.
        clicked => {
            if (flick.content-x <= flick.width - flick.content-width + 1px) {
                flick.content-x = 0;
            } else {
                flick.content-x = max(flick.width - flick.content-width, flick.content-x - flick.width);
            }
        }
    }
}

// A switch in the colors of the layout.
component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 52px * Ui.k;
    height: 28px * Ui.k;
    border-radius: (self.height / 2) * Theme.round;
    background: on ? Theme.accent : Theme.handle;
    animate background { duration: 150ms; }
    Rectangle {
        width: parent.height - 6px * Ui.k;
        height: self.width;
        border-radius: (self.width / 2) * Theme.round;
        y: 3px * Ui.k;
        x: root.on ? parent.width - self.width - 3px * Ui.k : 3px * Ui.k;
        background: #ffffff;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    callback clicked();
    height: 44px * Ui.k;
    width: label.preferred-width + 36px * Ui.k;
    border-radius: (self.height / 2) * Theme.round;
    background: strong ? (area.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : (area.has-hover ? Theme.hover : transparent);
    border-width: strong ? 0 : 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        font-size: 18px * Ui.k;
        color: root.strong ? #ffffff : Theme.text;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small round button with a letter (- / + / theme).
component Dot inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> tip;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: (15px) * Theme.round;
    border-width: 1px;
    border-color: Theme.border;
    background: zt.has-hover ? Theme.hover : transparent;
    if !root.has-icon: Text { text: root.text; font-size: 18px; color: Theme.dim; }
    if root.has-icon: Image { width: 18px; height: 18px; source: root.icon; colorize: Theme.dim; }
    zt := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page that scrolls, with the scrollbar of the layout (a track with a rounded thumb).
component Page inherits Rectangle {
    in property <length> content-height;
    callback near-end();
    flick := Flickable {
        x: Ui.rtl ? 20px * Ui.k : 0;
        width: parent.width - 20px * Ui.k;
        height: parent.height;
        content-height: max(root.content-height, self.height);
        changed content-y => {
            if (-self.content-y + self.height > self.content-height - 400px) {
                root.near-end();
            }
        }
        @children
    }
    property <length> track: root.height;
    property <length> thumb: max(60px, track * min(1, flick.height / max(1px, flick.content-height)));
    Rectangle {
        x: Ui.rtl ? 0 : parent.width - 20px * Ui.k;
        width: Theme.wide ? 10px * Ui.k : 20px * Ui.k;
        background: Theme.wide ? transparent : Theme.bar;
        visible: flick.content-height > flick.height + 1px;
        Rectangle {
            y: (root.track - root.thumb) * (-flick.content-y / max(1px, flick.content-height - flick.height));
            height: root.thumb;
            border-radius: (12px * Ui.k) * Theme.round;
            border-width: Theme.wide ? 0 : 2px * Ui.k;
            border-color: Theme.bar;
            background: Theme.wide ? Theme.handle : Theme.bg;
            TouchArea {
                property <length> start-view;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-view = flick.content-y;
                    }
                }
                moved => {
                    if (self.pressed) {
                        flick.content-y = max(flick.height - flick.content-height, min(0px,
                            self.start-view - (self.mouse-y - self.pressed-y) * (flick.content-height - flick.height) / max(1px, root.track - root.thumb)));
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- the playing song

component Wave inherits Rectangle {
    // The bars of the layout; the played part in the warm gradient.
    property <float> played: App.duration > 0 ? App.position / App.duration : 0;
    property <int> count: App.wave.length;
    property <length> step: self.width / max(1, count);
    for h[i] in App.wave: Rectangle {
        x: i * root.step;
        width: root.step * 0.57;
        height: root.height * max(0.06, min(1, h));
        y: (root.height - self.height) / 2;
        border-radius: (Theme.wide ? self.width / 2 : 0) * Theme.round;
        property <float> at: (i + 0.5) / max(1, root.count);
        background: self.at <= root.played
            ? Theme.wave-from.mix(Theme.wave-to, 1 - self.at / max(0.01, root.played))
            : Theme.bar;
        animate height { duration: 90ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { App.seek(max(0, min(1, self.mouse-x / root.width)) * App.duration); }
        moved => {
            if (self.pressed) {
                App.seek(max(0, min(1, self.mouse-x / root.width)) * App.duration);
            }
        }
    }
}

component Volume inherits Rectangle {
    // The speaker on top, then the track: the level from the bottom in the accent color.
    Icon {
        x: 0;
        y: 0;
        size: 40px * Ui.k;
        source: App.volume > 0.01 ? @image-url("icons/volume-loud-bold.svg") : @image-url("icons/volume-cross-bold.svg");
        clicked => { App.set-volume(App.volume > 0.01 ? 0 : 0.8); }
    }
    property <length> top: 55px * Ui.k;
    property <length> span: root.height - top;
    Rectangle { x: 18px * Ui.k; y: root.top; width: 4px * Ui.k; height: root.span; border-radius: 2px * Ui.k; background: Theme.bar; }
    Rectangle { x: 18px * Ui.k; y: root.top + root.span * (1 - App.volume); width: 4px * Ui.k; height: root.span * App.volume; border-radius: 2px * Ui.k; background: Theme.accent; }
    Rectangle {
        width: 16px * Ui.k;
        height: self.width;
        border-radius: (self.width / 2) * Theme.round;
        x: 20px * Ui.k - self.width / 2;
        y: root.top + root.span * (1 - App.volume) - self.height / 2;
        background: Theme.handle;
        border-width: 2px * Ui.k;
        border-color: Theme.bar;
    }
    TouchArea {
        y: root.top - 10px;
        height: root.span + 20px;
        mouse-cursor: pointer;
        clicked => { App.set-volume(max(0, min(1, 1 - (self.mouse-y - 10px) / root.span))); }
        moved => {
            if (self.pressed) {
                App.set-volume(max(0, min(1, 1 - (self.mouse-y - 10px) / root.span)));
            }
        }
        scroll-event(e) => {
            App.set-volume(max(0, min(1, App.volume + (e.delta-y > 0 ? 0.05 : -0.05))));
            accept
        }
    }
}

// A volume bar lying down (RyM Wide).
component FlatVolume inherits Rectangle {
    height: 30px * Ui.k;
    Rectangle { y: (parent.height - self.height) / 2; height: 4px * Ui.k; border-radius: 2px * Ui.k; background: Theme.bar; }
    Rectangle { y: (parent.height - self.height) / 2; width: parent.width * App.volume; height: 4px * Ui.k; border-radius: 2px * Ui.k; background: Theme.text; }
    Rectangle {
        x: parent.width * App.volume - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px * Ui.k;
        height: self.width;
        border-radius: (self.width / 2) * Theme.round;
        background: Theme.text;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { App.set-volume(max(0, min(1, self.mouse-x / root.width))); }
        moved => {
            if (self.pressed) {
                App.set-volume(max(0, min(1, self.mouse-x / root.width)));
            }
        }
    }
}

// The synced lyrics: the sung line bright (the karaoke fills it as it's sung), romaji and
// English small under Japanese lines.
component Lyrics inherits Rectangle {
    border-radius: (6px * Ui.k) * Theme.round;
    background: Theme.dark ? #00000040 : #ffffff80;
    clip: true;
    property <length> pills-h: App.sources.length > 1 ? 44px * Ui.k : 0;
    property <length> glide-to;
    animate glide-to { duration: 520ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    changed glide-to => { flick.content-y = self.glide-to; }
    // The sources: one pill each, the shown one in the accent color.
    if App.sources.length > 1: Flickable {
        y: 8px * Ui.k;
        height: 30px * Ui.k;
        content-width: pills.preferred-width;
        pills := HorizontalLayout {
            padding-left: 14px * Ui.k;
            padding-right: 14px * Ui.k;
            spacing: 8px * Ui.k;
            for name[i] in App.sources: Rectangle {
                width: label.preferred-width + 22px * Ui.k;
                border-radius: (self.height / 2) * Theme.round;
                background: i == App.source-at ? Theme.accent : (pa.has-hover ? Theme.hover : Theme.raised.with-alpha(0.7));
                label := Text {
                    text: name;
                    font-size: 14px * Ui.k;
                    color: i == App.source-at ? #ffffff : Theme.text;
                }
                pa := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { App.pick-source(i); }
                }
            }
        }
    }
    flick := Flickable {
        y: root.pills-h;
        height: root.height - root.pills-h;
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding: 20px * Ui.k;
            spacing: 10px * Ui.k;
            if App.lyrics-note != "": Text {
                text: App.lyrics-note;
                font-size: 18px * Ui.k;
                color: Theme.dim;
                wrap: word-wrap;
                horizontal-alignment: Ui.start;
            }
            for l[i] in App.lyrics: row := VerticalLayout {
                spacing: 2px * Ui.k;
                // The sung line comes to about a third of the way down (by where it really is).
                property <bool> sung-now: l.state == 1;
                changed sung-now => {
                    if (self.sung-now) {
                        root.glide-to = round(max(flick.height - flick.content-height, min(0px, -self.y + flick.height / 3)) / 1px) * 1px;
                    }
                }
                Rectangle {
                    height: line.preferred-height;
                    line := Text {
                        width: parent.width;
                        text: l.text;
                        font-size: App.lyrics-size * (l.state == 1 ? 1.14 : 1.0) * 1px * Ui.k;
                        animate font-size { duration: 320ms; easing: ease-out; }
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-alignment: l.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        // To come: see-through; sung now: white; sung: a little white left.
                        color: Theme.text.with-alpha(l.state == 1 ? 1 : (l.state == 2 ? 0.55 : 0.3));
                        animate color { duration: 350ms; easing: ease-out; }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.lyric-clicked(i); }
                    }
                }
                if l.ro != "": Text {
                    text: l.ro;
                    font-size: App.lyrics-size * 0.55px * Ui.k;
                    wrap: word-wrap;
                    horizontal-alignment: Ui.start;
                    color: Theme.text.with-alpha(l.state == 1 ? 0.9 : (l.state == 2 ? 0.45 : 0.25));
                    animate color { duration: 350ms; easing: ease-out; }
                }
                if l.tr != "": Text {
                    text: l.tr;
                    font-size: App.lyrics-size * 0.55px * Ui.k;
                    wrap: word-wrap;
                    horizontal-alignment: Ui.start;
                    color: Theme.text.with-alpha(l.state == 1 ? 0.9 : (l.state == 2 ? 0.45 : 0.25));
                    animate color { duration: 350ms; easing: ease-out; }
                }
            }
        }
    }
}

// The speed by the heart: what it is, and a list to pick another.
component SpeedButton inherits Rectangle {
    in property <length> size: 44px * Ui.k;
    height: self.size;
    width: max(self.size, label.preferred-width + 22px * Ui.k);
    border-radius: (self.height / 2) * Theme.round;
    border-width: 1px;
    border-color: App.speed-text == "1×" ? Theme.border : Theme.accent;
    background: area.has-hover ? Theme.hover : transparent;
    label := Text {
        text: App.speed-text;
        font-size: root.size * 0.36;
        font-weight: 700;
        color: App.speed-text == "1×" ? Theme.icon : Theme.accent;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { list.show(); }
    }
    list := PopupWindow {
        y: root.height + 6px;
        x: (root.width - 180px) / 2;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: (12px) * Theme.round;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                for o in [
                    { id: "0.75", label: "0.75×" },
                    { id: "1", label: "1×" },
                    { id: "1.25", label: "1.25×" },
                    { id: "1.5", label: "1.5×" },
                    { id: "nightcore", label: "Nightcore" },
                    { id: "slowed", label: "Slowed" },
                ]: Rectangle {
                    height: 36px;
                    border-radius: (8px) * Theme.round;
                    background: oa.has-hover ? Theme.hover : transparent;
                    Text {
                        x: 12px;
                        text: o.label;
                        font-size: 15px;
                        font-weight: App.speed-text == o.label ? 700 : 400;
                        color: App.speed-text == o.label ? Theme.accent : Theme.text;
                    }
                    oa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.set-speed(o.id); }
                    }
                }
            }
        }
    }
}

// The account's picture, or the plain figure; it opens the account's menu.
component Account inherits Rectangle {
    border-radius: (self.width / 2) * Theme.round;
    clip: true;
    if App.has-avatar: Image { width: 100%; height: 100%; source: App.avatar; image-fit: cover; }
    if !App.has-avatar: Image { width: 100%; height: 100%; source: @image-url("icons/user.svg"); colorize: Theme.icon; }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: Ui.rtl ? -250px * Ui.k : 0;
        y: -190px * Ui.k;
        width: 300px * Ui.k;
        Rectangle {
            background: Theme.raised;
            border-radius: (14px * Ui.k) * Theme.round;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 18px * Ui.k;
                spacing: 12px * Ui.k;
                Text { text: App.signed-in ? App.account-name : App.tr("Not signed in"); font-size: 22px * Ui.k; font-weight: 700; color: Theme.text; overflow: elide; horizontal-alignment: Ui.start; }
                if App.account-handle != "": Text { text: App.account-handle; font-size: 16px * Ui.k; color: Theme.dim; horizontal-alignment: Ui.start; }
                Button {
                    text: App.signed-in ? App.tr("Sign out") : App.tr("Sign in with Google");
                    strong: !App.signed-in;
                    clicked => {
                        if (App.signed-in) {
                            App.sign-out();
                        } else {
                            App.sign-in();
                        }
                    }
                }
            }
        }
    }
}

// The small buttons beside the cover: lyrics, floating lyrics, mini player, share.
component SideButtons inherits VerticalLayout {
    spacing: 10px * Ui.k;
    Icon { size: 40px * Ui.k; source: @image-url("icons/text-square-bold.svg"); tint: App.show-lyrics ? Theme.accent : Theme.icon; tip: App.tr("Lyrics"); clicked => { App.show-lyrics = !App.show-lyrics; } }
    Icon { size: 40px * Ui.k; source: @image-url("icons/square-top-down-linear.svg"); tip: App.tr("Floating lyrics"); clicked => { App.float-lyrics(); } }
    Icon { size: 40px * Ui.k; source: @image-url("icons/minimize-square-3-linear.svg"); tip: App.tr("Mini player"); clicked => { App.mini(); } }
    Icon { size: 40px * Ui.k; source: @image-url("icons/share-linear.svg"); tip: App.tr("Share as a picture"); clicked => { App.share(); } }
}

component NowPlaying inherits Rectangle {
    background: Theme.glass > 0 ? Theme.raised : Theme.bg;
    border-top-right-radius: (Ui.rtl ? 0 : 34px * Ui.k) * Theme.round;
    border-bottom-right-radius: (Ui.rtl ? 0 : 34px * Ui.k) * Theme.round;
    border-top-left-radius: (Ui.rtl ? 34px * Ui.k : 0) * Theme.round;
    border-bottom-left-radius: (Ui.rtl ? 34px * Ui.k : 0) * Theme.round;
    clip: true;
    // The cover, blurred, behind it all.
    Image {
        width: 100%;
        height: 100%;
        source: App.backdrop;
        image-fit: cover;
        opacity: Theme.glass > 0 || Theme.cover-border ? 0 : (Theme.custom ? 0.06 : (Theme.dark ? 0.16 : 0.3));
    }
    Backdrop {
        width: 100%;
        height: 100%;
    }
    Rectangle {
        y: max(0px, (root.height - 1024px * Ui.k) / 2);
        height: 1024px * Ui.k;
        // RyM, and the size and theme buttons under it.
        Text {
            x: Ui.rtl ? parent.width - 150px * Ui.k : 36px * Ui.k;
            y: 40px * Ui.k;
            text: "RyM";
            font-size: 34px * Ui.k;
            font-weight: 300;
            letter-spacing: 3px * Ui.k;
            color: Theme.text;
        }
        HorizontalLayout {
            x: Ui.rtl ? parent.width - 150px * Ui.k : 36px * Ui.k;
            y: 96px * Ui.k;
            spacing: 6px;
            Dot { text: "−"; tip: App.tr("Smaller"); clicked => { App.zoom(Ui.zoom - 0.05); } }
            Dot { text: "+"; tip: App.tr("Bigger"); clicked => { App.zoom(Ui.zoom + 0.05); } }
            Dot { has-icon: true; icon: @image-url("icons/pallete-2-bold.svg"); tip: App.tr("Theme"); clicked => { App.next-theme(); } }
        }
        if Theme.vu: HorizontalLayout {
            x: 278px * Ui.k;
            y: 8px * Ui.k;
            width: 506px * Ui.k;
            height: 66px * Ui.k;
            spacing: 14px * Ui.k;
            VuMeter { level: Theme.vu-l; label: "L"; }
            VuMeter { level: Theme.vu-r; label: "R"; }
        }
        if !Theme.vu: Text {
            x: 278px * Ui.k;
            y: 29px * Ui.k;
            width: 506px * Ui.k;
            height: 51px * Ui.k;
            text: App.tr("NOW PLAYING");
            font-family: "Chathura";
            font-size: 40px * Ui.k;
            letter-spacing: self.text == "NOW PLAYING" ? 37.6px * Ui.k : 0;
            horizontal-alignment: center;
            color: Theme.text;
        }
        Volume {
            x: 207px * Ui.k;
            y: 81px * Ui.k;
            width: 40px * Ui.k;
            height: 505px * Ui.k;
        }
        // The cover, or the lyrics in its place.
        if !App.show-lyrics && Theme.vinyl: Vinyl {
            x: 278px * Ui.k;
            y: 80px * Ui.k;
            width: 506px * Ui.k;
            height: 506px * Ui.k;
            source: App.cover;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { App.show-lyrics = true; }
            }
        }
        if !App.show-lyrics && !Theme.vinyl: Cover {
            x: 278px * Ui.k;
            y: 80px * Ui.k;
            width: 506px * Ui.k;
            height: 506px * Ui.k;
            radius: 2px * Ui.k;
            source: App.cover;
            border-width: Theme.cover-border ? 2px * Ui.k : 0;
            border-color: Theme.cover-color;
            drop-shadow-blur: Theme.glow ? 34px * Ui.k : 0;
            drop-shadow-color: Theme.accent.with-alpha(0.55);
            TouchArea {
                mouse-cursor: pointer;
                clicked => { App.show-lyrics = true; }
            }
        }
        if App.show-lyrics: Lyrics {
            x: 278px * Ui.k;
            y: 80px * Ui.k;
            width: 506px * Ui.k;
            height: 506px * Ui.k;
        }
        SideButtons {
            x: 790px * Ui.k;
            y: 80px * Ui.k;
        }
        VerticalLayout {
            x: 278px * Ui.k;
            y: 610px * Ui.k;
            width: 506px * Ui.k;
            height: 120px * Ui.k;
            alignment: start;
            spacing: 14px * Ui.k;
            Text {
                text: App.has-song ? App.title : App.tr("Nothing playing");
                font-size: 48px * Ui.k;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: Ui.start;
            }
            // The artist, with room on its right for the speed and the heart.
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1;
                    text: App.loading ? App.tr("Loading…") : App.artist;
                    font-size: 24px * Ui.k;
                    color: artist-area.has-hover ? Theme.accent : Theme.dim;
                    overflow: elide;
                    horizontal-alignment: Ui.start;
                    vertical-alignment: center;
                    artist-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.open-artist(); }
                    }
                }
                Rectangle { width: 124px * Ui.k; }
            }
        }
        // On the artist's line, at its right end: the speed, then the heart.
        speed := SpeedButton {
            x: heart.x - self.width - 10px * Ui.k;
            y: 672px * Ui.k;
        }
        heart := Icon {
            x: 784px * Ui.k - self.width;
            y: 671px * Ui.k;
            size: 46px * Ui.k;
            source: App.liked ? @image-url("icons/heart-bold.svg") : @image-url("icons/heart-linear.svg");
            tint: Theme.accent;
            tip: App.tr("Like");
            clicked => { App.like-now(); }
        }
        if App.sleep-text != "": Text {
            x: 278px * Ui.k;
            y: 740px * Ui.k;
            text: "☾ " + App.sleep-text;
            font-size: 16px * Ui.k;
            color: Theme.accent;
        }
        Text {
            x: 210px * Ui.k;
            y: 784px * Ui.k;
            width: 64px * Ui.k;
            text: App.pos-text;
            font-family: Theme.clock-font;
            font-size: 24px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: right;
        }
        Wave {
            x: 285px * Ui.k;
            y: 776px * Ui.k;
            width: 495px * Ui.k;
            height: 43px * Ui.k;
        }
        Text {
            x: 794px * Ui.k;
            y: 784px * Ui.k;
            text: App.len-text;
            font-family: Theme.clock-font;
            font-size: 24px * Ui.k;
            color: Theme.dim;
        }
        Icon {
            x: 234px * Ui.k;
            y: 880px * Ui.k;
            source: @image-url("icons/playlist.svg");
            tint: App.queue-open && App.page == 0 ? Theme.accent : Theme.icon;
            tip: App.tr("Up next");
            clicked => {
                App.go(0);
                App.queue-open = !App.queue-open;
            }
        }
        Icon { x: 352px * Ui.k; y: 883px * Ui.k; size: 56px * Ui.k; source: @image-url("icons/previous.svg"); tip: App.tr("Previous"); clicked => { App.previous(); } }
        Icon { x: 478px * Ui.k; y: 864px * Ui.k; size: 94px * Ui.k; source: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg"); tip: App.tr("Play / pause"); clicked => { App.toggle-play(); } }
        Icon { x: 642px * Ui.k; y: 883px * Ui.k; size: 56px * Ui.k; source: @image-url("icons/next.svg"); tip: App.tr("Next"); clicked => { App.next(); } }
        Icon {
            x: 767px * Ui.k;
            y: 882px * Ui.k;
            source: App.repeat-one ? @image-url("icons/repeat-one-linear.svg") : @image-url("icons/repeat.svg");
            tint: App.repeat-one || App.repeat-all ? Theme.accent : Theme.icon;
            tip: App.repeat-one ? App.tr("Repeat this song") : (App.repeat-all ? App.tr("Repeat all") : App.tr("Repeat"));
            clicked => { App.repeat(); }
        }
        Account {
            x: Ui.rtl ? parent.width - 100px * Ui.k : 42px * Ui.k;
            y: 882px * Ui.k;
            width: 58px * Ui.k;
            height: 58px * Ui.k;
        }
    }
}

// The rail of the layout: home, the playing song, search, library, settings.
component Rail inherits Rectangle {
    width: 140px * Ui.k;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border;
    border-top-right-radius: (Ui.rtl ? 0 : 34px * Ui.k) * Theme.round;
    border-bottom-right-radius: (Ui.rtl ? 0 : 34px * Ui.k) * Theme.round;
    border-top-left-radius: (Ui.rtl ? 34px * Ui.k : 0) * Theme.round;
    border-bottom-left-radius: (Ui.rtl ? 34px * Ui.k : 0) * Theme.round;
    VerticalLayout {
        padding-top: 44px * Ui.k;
        padding-bottom: 44px * Ui.k;
        spacing: 40px * Ui.k;
        alignment: center;
        for item in [
            { page: 3, icon: @image-url("icons/home-2-bold.svg"), tip: "Home" },
            { page: 0, icon: @image-url("icons/nav-play.svg"), tip: "Now playing" },
            { page: 1, icon: @image-url("icons/nav-search.svg"), tip: "Search" },
            { page: 2, icon: @image-url("icons/nav-library.svg"), tip: "Library" },
            { page: 6, icon: @image-url("icons/chart-2-bold.svg"), tip: "Your stats" },
            { page: 4, icon: @image-url("icons/settings-bold.svg"), tip: "Settings" },
        ]: HorizontalLayout {
            alignment: center;
            Icon {
                source: item.icon;
                tint: App.page == item.page || (item.page == 2 && App.page == 5) ? Theme.accent : Theme.icon;
                tip: App.tr(item.tip);
                clicked => { App.go(item.page); }
            }
        }
    }
}

// ---------------------------------------------------------------- the pages

component UpNext inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header {
            title: App.tr("Queue");
            action: App.queue-open ? App.tr("Less") : App.tr("Extend");
            action2: App.queue.length > 0 && App.signed-in ? App.tr("Save") : "";
            acted => { App.queue-open = !App.queue-open; }
            acted2 => { App.menu("save-queue", ""); }
        }
        if App.queue.length == 0: Text {
            text: App.tr("Nothing is coming up");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Ui.start;
        }
        VerticalLayout {
            spacing: 0;
            for s[i] in App.queue: SongRow {
                song: s;
                in-queue: true;
                visible: App.queue-open || i < 4;
                height: App.queue-open || i < 4 ? 106px * Ui.k : 0;
            }
        }
        Rectangle { height: 26px * Ui.k; }
        Header {
            title: App.tr("Similar songs");
            action: App.tr("See More");
            acted => { App.menu("similar-all", ""); }
        }
        CardRow { cards: App.similar; }
        if App.artist-name != "": Header {
            title: App.tr("From the same artist");
            action: App.tr("See More");
            acted => { App.open-artist(); }
        }
        CardRow { cards: App.same-artist; }
    }
}

component SearchBox inherits Rectangle {
    height: 60px * Ui.k;
    border-radius: (self.height / 2) * Theme.round;
    background: Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 22px * Ui.k;
        padding-right: 22px * Ui.k;
        spacing: 14px * Ui.k;
        Image {
            width: 26px * Ui.k;
            source: @image-url("icons/magnifer-linear.svg");
            colorize: Theme.dim;
        }
        input := TextInput {
            text <=> App.query;
            font-size: 22px * Ui.k;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: Ui.start;
            single-line: true;
            edited => {
                App.typed(self.text);
                if (App.page != 1) {
                    App.go(1);
                }
            }
            accepted => { App.search(self.text); }
        }
    }
}

component SearchPage inherits Page {
    content-height: col.preferred-height;
    near-end => { App.more(); }
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header { title: App.tr("Search"); }
        if !Theme.wide: SearchBox { }
        if App.has-soundcloud: HorizontalLayout {
            spacing: 8px * Ui.k;
            alignment: Ui.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            for where[wi] in ["YouTube Music", "SoundCloud"]: Rectangle {
                height: 34px * Ui.k;
                width: wl.preferred-width + 26px * Ui.k;
                border-radius: (self.height / 2) * Theme.round;
                background: App.search-in == wi ? Theme.accent : (wa.has-hover ? Theme.hover : Theme.raised);
                wl := Text { text: where; font-size: 15px * Ui.k; color: App.search-in == wi ? #ffffff : Theme.text; }
                wa := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        App.search-in = wi;
                        if (App.query != "") { App.search(App.query); }
                    }
                }
            }
        }
        // While typing: suggestions (the account's searches first, with a way to forget them).
        for g[i] in App.suggestions: Rectangle {
            height: 52px * Ui.k;
            border-radius: (10px * Ui.k) * Theme.round;
            background: pick.has-hover ? Theme.hover : transparent;
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.pick-suggestion(i); }
            }
            HorizontalLayout {
                padding-left: 22px * Ui.k;
                padding-right: 12px * Ui.k;
                spacing: 14px * Ui.k;
                Image {
                    width: 22px * Ui.k;
                    source: g.history ? @image-url("icons/history-linear.svg") : @image-url("icons/magnifer-linear.svg");
                    colorize: Theme.dim;
                }
                Text {
                    text: g.text;
                    font-size: 20px * Ui.k;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: Ui.start;
                    overflow: elide;
                }
                if g.history: Icon {
                    size: 34px * Ui.k;
                    source: @image-url("icons/close-circle-linear.svg");
                    tip: App.tr("Remove from search history");
                    clicked => { App.forget-suggestion(i); }
                }
            }
        }
        if App.searching: Text {
            text: App.tr("Searching…");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Ui.start;
        }
        for s in App.results: SongRow { song: s; handle: false; }
    }
}

component Grid inherits Rectangle {
    // Cards in rows that fit the width.
    in property <[Card]> cards;
    property <length> cell: 184px * Ui.k;
    property <int> per-row: max(1, floor(self.width / cell));
    height: ceil(cards.length / per-row) * 260px * Ui.k;
    for c[i] in root.cards: CardItem {
        x: Ui.rtl ? root.width - (mod(i, root.per-row) + 1) * root.cell : mod(i, root.per-row) * root.cell;
        y: floor(i / root.per-row) * 260px * Ui.k;
        card: c;
    }
}

component LibraryPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header { title: App.tr("Library"); }
        if !App.signed-in: VerticalLayout {
            spacing: 18px * Ui.k;
            padding-left: 12px * Ui.k;
            Text {
                text: App.tr("Sign in to see your liked songs and playlists");
                font-size: 20px * Ui.k;
                color: Theme.dim;
                wrap: word-wrap;
                horizontal-alignment: Ui.start;
            }
            HorizontalLayout {
                alignment: Ui.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button {
                    text: App.tr("Sign in with Google");
                    strong: true;
                    clicked => { App.sign-in(); }
                }
            }
        }
        Grid { cards: App.playlists; }
    }
}

component HomePage inherits Page {
    content-height: col.preferred-height;
    near-end => { App.more(); }
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 10px * Ui.k;
        Header {
            title: App.tr("Home");
            action: App.home-loading ? App.tr("Refreshing…") : App.tr("Refresh");
            acted => { App.refresh-home(); }
        }
        if App.home.length == 0: Text {
            text: App.home-loading ? App.tr("Loading your feed…") : App.tr("Nothing here yet");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Ui.start;
        }
        for shelf in App.home: VerticalLayout {
            spacing: 6px * Ui.k;
            Header { title: shelf.title; }
            CardRow { cards: shelf.cards; }
        }
    }
}

component ListPage inherits Page {
    content-height: col.preferred-height;
    near-end => {
        if (App.list-more) {
            App.more();
        }
    }
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 14px * Ui.k;
        Header {
            title: App.list-title;
            action: App.list.length > 0 ? App.tr("Play all") : "";
            action2: App.list.length > 0 ? App.tr("Download all") : "";
            acted => { App.play-all(); }
            acted2 => { App.menu("download-all", ""); }
        }
        if App.list-loading && App.list.length == 0: Text {
            text: App.tr("Loading…");
            font-size: 20px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Ui.start;
        }
        for s in App.list: SongRow { song: s; handle: false; }
    }
}

// Bars with their names (the stats page).
component Bars inherits VerticalLayout {
    in property <[Bar]> bars;
    spacing: 10px * Ui.k;
    for b in root.bars: VerticalLayout {
        spacing: 4px * Ui.k;
        HorizontalLayout {
            Text { text: b.label; font-size: 18px * Ui.k; color: Theme.text; horizontal-stretch: 1; overflow: elide; horizontal-alignment: Ui.start; }
            Text { text: b.text; font-size: 16px * Ui.k; color: Theme.dim; }
        }
        Rectangle {
            height: 12px * Ui.k;
            border-radius: (self.height / 2) * Theme.round;
            background: Theme.raised;
            Rectangle {
                x: Ui.rtl ? parent.width * (1 - max(0.02, b.value)) : 0;
                width: parent.width * max(0.02, b.value);
                border-radius: (parent.border-radius) * Theme.round;
                background: @linear-gradient(90deg, Theme.wave-from 0%, Theme.wave-to 100%);
            }
        }
    }
}

component StatsPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 12px * Ui.k;
        padding-right: Ui.rtl ? 12px * Ui.k : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 18px * Ui.k;
        Header { title: App.tr("Your stats"); }
        Text { text: App.stats-text; font-size: 20px * Ui.k; color: Theme.dim; wrap: word-wrap; horizontal-alignment: Ui.start; }
        Text { text: App.tr("What you listen to (RaM points)"); font-size: 26px * Ui.k; font-weight: 700; color: Theme.text; horizontal-alignment: Ui.start; }
        Bars { bars: App.kinds; }
        Text { text: App.tr("Top artists this month"); font-size: 26px * Ui.k; font-weight: 700; color: Theme.text; horizontal-alignment: Ui.start; }
        Bars { bars: App.top-artists; }
        Text { text: App.tr("Top songs"); font-size: 26px * Ui.k; font-weight: 700; color: Theme.text; horizontal-alignment: Ui.start; }
        Bars { bars: App.top-songs; }
    }
}

component SettingsPage inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 48px * Ui.k;
        padding-left: Ui.rtl ? 30px * Ui.k : 0;
        padding-right: Ui.rtl ? 0 : 30px * Ui.k;
        padding-bottom: 40px * Ui.k;
        spacing: 16px * Ui.k;
        Header { title: App.tr("Settings"); }
        for s in App.settings: Rectangle {
            height: row.preferred-height;
            row := HorizontalLayout {
                padding-left: 12px * Ui.k;
                padding-right: 4px * Ui.k;
                padding-top: s.kind == 4 ? 18px * Ui.k : 0;
                spacing: 18px * Ui.k;
                // In Arabic the control comes first (on the left).
                if Ui.rtl && s.kind != 4: VerticalLayout {
                    alignment: center;
                    if s.kind == 0: Switch { on: s.on; toggled(v) => { App.set-toggle(s.id, v); } }
                    if s.kind == 3: Button { text: s.value; clicked => { App.press(s.id); } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px * Ui.k;
                    Text {
                        text: s.title;
                        font-size: s.kind == 4 ? 28px * Ui.k : 21px * Ui.k;
                        font-weight: 700;
                        color: s.kind == 4 ? Theme.accent : Theme.text;
                        horizontal-alignment: Ui.start;
                    }
                    if s.about != "": Text {
                        text: s.about;
                        font-size: 16px * Ui.k;
                        color: Theme.dim;
                        wrap: word-wrap;
                        horizontal-alignment: Ui.start;
                    }
                }
                if !Ui.rtl && s.kind == 0: VerticalLayout {
                    alignment: center;
                    Switch { on: s.on; toggled(v) => { App.set-toggle(s.id, v); } }
                }
                if !Ui.rtl && s.kind == 3: VerticalLayout {
                    alignment: center;
                    Button { text: s.value; clicked => { App.press(s.id); } }
                }
                if s.kind == 1: HorizontalLayout {
                    spacing: 6px * Ui.k;
                    Icon { size: 36px * Ui.k; source: @image-url("icons/alt-arrow-left-linear.svg"); clicked => { App.choose(s.id, Ui.rtl ? 1 : -1); } }
                    Text { text: s.value; font-size: 19px * Ui.k; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; min-width: 150px * Ui.k; }
                    Icon { size: 36px * Ui.k; source: @image-url("icons/alt-arrow-right-linear.svg"); clicked => { App.choose(s.id, Ui.rtl ? -1 : 1); } }
                }
                if s.kind == 2: Rectangle {
                    width: 280px * Ui.k;
                    height: 44px * Ui.k;
                    border-radius: (10px * Ui.k) * Theme.round;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: field.has-focus ? Theme.accent : Theme.border;
                    field := TextInput {
                        x: 12px * Ui.k;
                        width: parent.width - 24px * Ui.k;
                        text: s.value;
                        font-size: 17px * Ui.k;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: s.id == "lastfm-secret" ? InputType.password : InputType.text;
                        accepted => { App.set-text(s.id, self.text); }
                        edited => { App.set-text(s.id, self.text); }
                    }
                }
            }
        }
        Text {
            text: "RyM " + App.version;
            font-size: 16px * Ui.k;
            color: Theme.dim;
            horizontal-alignment: Ui.start;
        }
        HorizontalLayout {
            alignment: Ui.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            padding-left: 12px * Ui.k;
            AboutSlint { max-height: 200px; }
        }
    }
}

// The page picked in the rail or the side list.
component Pages inherits Rectangle {
    if App.page == 0: UpNext { width: 100%; height: 100%; }
    if App.page == 1: SearchPage { width: 100%; height: 100%; }
    if App.page == 2: LibraryPage { width: 100%; height: 100%; }
    if App.page == 3: HomePage { width: 100%; height: 100%; }
    if App.page == 4: SettingsPage { width: 100%; height: 100%; }
    if App.page == 5: ListPage { width: 100%; height: 100%; }
    if App.page == 6: StatsPage { width: 100%; height: 100%; }
}

// ---------------------------------------------------------------- RyM Wide

component WideTop inherits Rectangle {
    height: 64px * Ui.k;
    background: Theme.bg;
    Text {
        x: Ui.rtl ? parent.width - self.width - 24px * Ui.k : 24px * Ui.k;
        y: (parent.height - self.height) / 2;
        text: "RyM";
        font-size: 30px * Ui.k;
        font-weight: 700;
        color: Theme.text;
    }
    SearchBox {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(640px * Ui.k, parent.width - 520px * Ui.k);
        height: 44px * Ui.k;
    }
    HorizontalLayout {
        x: Ui.rtl ? 20px * Ui.k : parent.width - self.preferred-width - 20px * Ui.k;
        y: (parent.height - self.height) / 2;
        height: 40px * Ui.k;
        spacing: 8px;
        Dot { text: "−"; tip: App.tr("Smaller"); clicked => { App.zoom(Ui.zoom - 0.05); } }
        Dot { text: "+"; tip: App.tr("Bigger"); clicked => { App.zoom(Ui.zoom + 0.05); } }
        Dot { has-icon: true; icon: @image-url("icons/pallete-2-bold.svg"); tip: App.tr("Theme"); clicked => { App.next-theme(); } }
        Account { width: 36px * Ui.k; height: 36px * Ui.k; }
    }
}

component WideSide inherits Rectangle {
    width: 250px * Ui.k;
    background: Theme.bg;
    VerticalLayout {
        padding: 12px * Ui.k;
        spacing: 4px * Ui.k;
        alignment: start;
        for item in [
            { page: 3, icon: @image-url("icons/home-2-bold.svg"), label: "Home" },
            { page: 0, icon: @image-url("icons/nav-play.svg"), label: "Now playing" },
            { page: 1, icon: @image-url("icons/nav-search.svg"), label: "Search" },
            { page: 2, icon: @image-url("icons/nav-library.svg"), label: "Library" },
            { page: 6, icon: @image-url("icons/chart-2-bold.svg"), label: "Your stats" },
            { page: 4, icon: @image-url("icons/settings-bold.svg"), label: "Settings" },
        ]: Rectangle {
            height: 48px * Ui.k;
            border-radius: (10px * Ui.k) * Theme.round;
            property <bool> on: App.page == item.page || (item.page == 2 && App.page == 5);
            background: on ? Theme.raised : (pick.has-hover ? Theme.hover : transparent);
            pick := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.go(item.page); }
            }
            Image {
                x: Ui.rtl ? parent.width - 40px * Ui.k : 14px * Ui.k;
                y: (parent.height - self.height) / 2;
                width: 26px * Ui.k;
                height: 26px * Ui.k;
                source: item.icon;
                colorize: Theme.text;
            }
            Text {
                x: Ui.rtl ? 12px * Ui.k : 58px * Ui.k;
                width: parent.width - 70px * Ui.k;
                y: (parent.height - self.height) / 2;
                text: App.tr(item.label);
                font-size: 17px * Ui.k;
                font-weight: parent.on ? 700 : 400;
                color: Theme.text;
                horizontal-alignment: Ui.start;
            }
        }
    }
}

component UpNextSide inherits Page {
    content-height: col.preferred-height;
    col := VerticalLayout {
        spacing: 2px * Ui.k;
        Header { title: App.tr("Up next"); }
        if App.queue.length == 0: Text { text: App.tr("Nothing is coming up"); font-size: 17px * Ui.k; color: Theme.dim; horizontal-alignment: Ui.start; }
        for s in App.queue: SongRow { song: s; in-queue: true; cover-size: 64px * Ui.k; title-size: 17px * Ui.k; }
        Rectangle { height: 14px * Ui.k; }
        Header { title: App.tr("Similar songs"); action: App.tr("See More"); acted => { App.menu("similar-all", ""); } }
        for c[i] in App.similar: Rectangle {
            height: 88px * Ui.k;
            border-radius: (8px * Ui.k) * Theme.round;
            background: ca.has-hover ? Theme.hover : transparent;
            ca := TouchArea { mouse-cursor: pointer; clicked => { App.open-card(c.key); } }
            ContextMenuArea {
                Menu {
                    MenuItem { title: App.tr("Play next"); activated => { App.menu("next", c.key); } }
                    MenuItem { title: App.tr("Add to queue"); activated => { App.menu("add", c.key); } }
                    MenuItem { title: App.tr("Start radio"); activated => { App.menu("radio", c.key); } }
                    Menu {
                        title: App.tr("Save to playlist");
                        for name[pi] in App.playlist-names: MenuItem { title: name; activated => { App.menu("save:" + pi, c.key); } }
                    }
                    MenuItem { title: App.tr("Go to album"); activated => { App.menu("album", c.key); } }
                    MenuItem { title: App.tr("Watch video"); enabled: App.has-video; activated => { App.menu("video", c.key); } }
                    MenuItem { title: App.tr("Download video"); enabled: App.has-video; activated => { App.menu("video-dl", c.key); } }
                    MenuItem { title: App.tr("Recommend more"); activated => { App.menu("more", c.key); } }
                    MenuItem { title: App.tr("Don't recommend"); activated => { App.menu("less", c.key); } }
                    MenuItem { title: false ? App.tr("Remove from liked songs") : App.tr("Add to liked songs"); activated => { App.menu("like", c.key); } }
                    MenuItem { title: App.tr("Go to artist"); activated => { App.menu("artist", c.key); } }
                    Menu {
                        title: App.tr("This artist's kind");
                        MenuItem { title: App.tr("Songs"); activated => { App.menu("kind:Songs", c.key); } }
                        MenuItem { title: App.tr("Husseini"); activated => { App.menu("kind:Husseini", c.key); } }
                        MenuItem { title: App.tr("Quran"); activated => { App.menu("kind:Quran", c.key); } }
                        MenuItem { title: App.tr("Nasheeds"); activated => { App.menu("kind:Nasheeds", c.key); } }
                        MenuItem { title: App.tr("Talks"); activated => { App.menu("kind:Talks", c.key); } }
                    }
                    MenuItem { title: App.tr("Download"); activated => { App.menu("download", c.key); } }
                    MenuItem { title: App.tr("Copy link"); activated => { App.menu("share", c.key); } }
                }
            }
            HorizontalLayout {
                padding: 12px * Ui.k;
                spacing: 14px * Ui.k;
                Cover { width: 64px * Ui.k; height: 64px * Ui.k; source: c.cover; radius: 8px * Ui.k; }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px * Ui.k;
                    Text { text: c.title; font-size: 17px * Ui.k; font-weight: 700; color: Theme.text; overflow: elide; horizontal-alignment: Ui.start; }
                    Text { text: c.sub; font-size: 14px * Ui.k; color: Theme.dim; overflow: elide; horizontal-alignment: Ui.start; }
                }
            }
        }
    }
}

// The playing song like a watch page: the picture (cover over its blurred copy) with the
// controls under it, and Up next beside it.
component WatchPage inherits Rectangle {
    property <length> side: min(420px * Ui.k, root.width * 0.34);
    property <length> main-w: root.width - side - 36px * Ui.k;
    Flickable {
        x: Ui.rtl ? root.side + 24px * Ui.k : 12px * Ui.k;
        width: root.main-w;
        content-height: main.preferred-height + 40px;
        main := VerticalLayout {
            alignment: start;
            spacing: 14px * Ui.k;
            Rectangle {
                height: root.main-w * 9 / 16;
                border-radius: (14px * Ui.k) * Theme.round;
                clip: true;
                background: #000000;
                Image { width: 100%; height: 100%; source: App.backdrop; image-fit: cover; opacity: 0.55; }
                if !App.show-lyrics && Theme.vinyl: Vinyl {
                    width: parent.height * 0.86;
                    height: self.width;
                    source: App.cover;
                    TouchArea { mouse-cursor: pointer; clicked => { App.show-lyrics = true; } }
                }
                if !App.show-lyrics && !Theme.vinyl: Cover {
                    width: parent.height * 0.82;
                    height: self.width;
                    radius: 10px * Ui.k;
                    source: App.cover;
                    border-width: Theme.cover-border ? 2px * Ui.k : 0;
                    border-color: Theme.cover-color;
                    drop-shadow-blur: Theme.glow ? 30px * Ui.k : 0;
                    drop-shadow-color: Theme.accent.with-alpha(0.55);
                    TouchArea { mouse-cursor: pointer; clicked => { App.show-lyrics = true; } }
                }
                // Hi-Fi Rack: the needle meters over the bottom of the picture.
                if Theme.vu: HorizontalLayout {
                    y: parent.height - self.height - 12px * Ui.k;
                    x: 12px * Ui.k;
                    width: min(parent.width - 24px * Ui.k, 420px * Ui.k);
                    height: 60px * Ui.k;
                    spacing: 10px * Ui.k;
                    VuMeter { level: Theme.vu-l; label: "L"; }
                    VuMeter { level: Theme.vu-r; label: "R"; }
                }
                if App.show-lyrics: Lyrics {
                    width: parent.width * 0.86;
                    height: parent.height * 0.86;
                }
            }
            Text {
                text: App.has-song ? App.title : App.tr("Nothing playing");
                font-size: 26px * Ui.k;
                font-weight: 700;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: Ui.start;
            }
            HorizontalLayout {
                spacing: 12px * Ui.k;
                Rectangle {
                    width: 44px * Ui.k;
                    height: 44px * Ui.k;
                    border-radius: (self.width / 2) * Theme.round;
                    clip: true;
                    Image { width: 100%; height: 100%; source: App.cover; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: App.loading ? App.tr("Loading…") : App.artist;
                        font-size: 18px * Ui.k;
                        font-weight: 700;
                        color: wa.has-hover ? Theme.accent : Theme.text;
                        overflow: elide;
                        horizontal-alignment: Ui.start;
                        wa := TouchArea { mouse-cursor: pointer; clicked => { App.open-artist(); } }
                    }
                    if App.sleep-text != "": Text { text: "☾ " + App.sleep-text; font-size: 14px * Ui.k; color: Theme.accent; horizontal-alignment: Ui.start; }
                }
                VerticalLayout { alignment: center; SpeedButton { size: 40px * Ui.k; } }
                for b in [
                    { id: 0, icon: App.liked ? @image-url("icons/heart-bold.svg") : @image-url("icons/heart-linear.svg"), label: App.tr("Like") },
                    { id: 1, icon: @image-url("icons/text-square-bold.svg"), label: App.tr("Lyrics") },
                    { id: 2, icon: @image-url("icons/square-top-down-linear.svg"), label: App.tr("Floating lyrics") },
                    { id: 3, icon: @image-url("icons/minimize-square-3-linear.svg"), label: App.tr("Mini player") },
                    { id: 4, icon: @image-url("icons/share-linear.svg"), label: App.tr("Share") },
                ]: Rectangle {
                    height: 40px * Ui.k;
                    width: pill.preferred-width + 28px * Ui.k;
                    border-radius: (self.height / 2) * Theme.round;
                    background: pa.has-hover ? Theme.handle : Theme.raised;
                    pill := HorizontalLayout {
                        x: 14px * Ui.k;
                        spacing: 8px * Ui.k;
                        Image { width: 20px * Ui.k; source: b.icon; colorize: b.id == 0 && App.liked ? Theme.accent : Theme.text; }
                        Text { text: b.label; font-size: 15px * Ui.k; color: Theme.text; vertical-alignment: center; }
                    }
                    pa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (b.id == 0) { App.like-now(); }
                            if (b.id == 1) { App.show-lyrics = !App.show-lyrics; }
                            if (b.id == 2) { App.float-lyrics(); }
                            if (b.id == 3) { App.mini(); }
                            if (b.id == 4) { App.share(); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px * Ui.k;
                Text { text: App.pos-text; font-family: Theme.clock-font; font-size: 16px * Ui.k; color: Theme.dim; vertical-alignment: center; }
                Wave { height: 34px * Ui.k; horizontal-stretch: 1; }
                Text { text: App.len-text; font-family: Theme.clock-font; font-size: 16px * Ui.k; color: Theme.dim; vertical-alignment: center; }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 18px * Ui.k;
                Icon { size: 44px * Ui.k; source: App.repeat-one ? @image-url("icons/repeat-one-linear.svg") : @image-url("icons/repeat.svg"); tint: App.repeat-one || App.repeat-all ? Theme.accent : Theme.icon; clicked => { App.repeat(); } }
                Icon { size: 48px * Ui.k; source: @image-url("icons/previous.svg"); clicked => { App.previous(); } }
                Icon { size: 68px * Ui.k; source: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg"); clicked => { App.toggle-play(); } }
                Icon { size: 48px * Ui.k; source: @image-url("icons/next.svg"); clicked => { App.next(); } }
                VerticalLayout { alignment: center; FlatVolume { width: 150px * Ui.k; } }
            }
        }
    }
    // Up next, then similar songs.
    Rectangle {
        x: Ui.rtl ? 0 : root.width - root.side;
        width: root.side;
        UpNextSide { width: 100%; height: 100%; }
    }
}

// The player along the bottom (RyM Wide, away from the watch page).
component BottomBar inherits Rectangle {
    height: 80px * Ui.k;
    background: Theme.raised;
    // The progress along its top: click to seek.
    Rectangle {
        y: 0;
        height: 3px * Ui.k;
        background: Theme.bar;
        Rectangle {
            x: Ui.rtl ? parent.width * (1 - (App.duration > 0 ? App.position / App.duration : 0)) : 0;
            width: parent.width * (App.duration > 0 ? App.position / App.duration : 0);
            background: Theme.accent;
        }
        TouchArea {
            y: -6px;
            height: 15px;
            mouse-cursor: pointer;
            clicked => { App.seek(max(0, min(1, (Ui.rtl ? root.width - self.mouse-x : self.mouse-x) / root.width)) * App.duration); }
        }
    }
    // Everything in the middle of the bar's height (under the progress line).
    HorizontalLayout {
        y: 3px * Ui.k;
        height: parent.height - 3px * Ui.k;
        padding-left: 18px * Ui.k;
        padding-right: 18px * Ui.k;
        spacing: 16px * Ui.k;
        // Previous / play / next, and the time.
        HorizontalLayout {
            alignment: start;
            spacing: 10px * Ui.k;
            VerticalLayout { alignment: center; Icon { size: 42px * Ui.k; source: @image-url("icons/previous.svg"); clicked => { App.previous(); } } }
            VerticalLayout { alignment: center; Icon { size: 52px * Ui.k; source: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg"); clicked => { App.toggle-play(); } } }
            VerticalLayout { alignment: center; Icon { size: 42px * Ui.k; source: @image-url("icons/next.svg"); clicked => { App.next(); } } }
            VerticalLayout {
                alignment: center;
                padding-left: 6px * Ui.k;
                Text { text: App.pos-text + " / " + App.len-text; font-family: Theme.clock-font; font-size: 15px * Ui.k; color: Theme.dim; }
            }
        }
        // The song: its cover, names and heart, in the middle; a click opens it.
        Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: center;
                spacing: 14px * Ui.k;
                VerticalLayout { alignment: center; Cover { width: 54px * Ui.k; height: 54px * Ui.k; source: App.cover; } }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px * Ui.k;
                    max-width: 420px * Ui.k;
                    Text { text: App.has-song ? App.title : App.tr("Nothing playing"); font-size: 17px * Ui.k; font-weight: 700; color: Theme.text; overflow: elide; }
                    Text { text: App.artist; font-size: 14px * Ui.k; color: Theme.dim; overflow: elide; }
                }
                VerticalLayout { alignment: center; SpeedButton { size: 34px * Ui.k; } }
                VerticalLayout { alignment: center; Icon { size: 38px * Ui.k; source: App.liked ? @image-url("icons/heart-bold.svg") : @image-url("icons/heart-linear.svg"); tint: Theme.accent; clicked => { App.like-now(); } } }
            }
            TouchArea {
                width: parent.width * 0.5;
                x: parent.width * 0.25;
                mouse-cursor: pointer;
                clicked => { App.go(0); }
            }
        }
        // Repeat and the volume.
        HorizontalLayout {
            alignment: end;
            spacing: 10px * Ui.k;
            VerticalLayout { alignment: center; Icon { size: 38px * Ui.k; source: App.repeat-one ? @image-url("icons/repeat-one-linear.svg") : @image-url("icons/repeat.svg"); tint: App.repeat-one || App.repeat-all ? Theme.accent : Theme.icon; clicked => { App.repeat(); } } }
            VerticalLayout { alignment: center; FlatVolume { width: 120px * Ui.k; } }
        }
    }
}

component WideLayout inherits Rectangle {
    background: Theme.bg;
    WideTop { y: 0; width: parent.width; }
    WideSide {
        x: Ui.rtl ? parent.width - self.width : 0;
        y: 64px * Ui.k;
        height: parent.height - 64px * Ui.k - (App.page == 0 ? 0 : 80px * Ui.k);
    }
    Rectangle {
        x: Ui.rtl ? 0 : 250px * Ui.k;
        y: 64px * Ui.k;
        width: parent.width - 250px * Ui.k;
        height: parent.height - 64px * Ui.k - (App.page == 0 ? 0 : 80px * Ui.k);
        if App.page == 0: WatchPage { width: 100%; height: 100%; }
        if App.page != 0: Pages { width: 100%; height: 100%; }
    }
    if App.page != 0: BottomBar { y: parent.height - self.height; width: parent.width; }
}

// ---------------------------------------------------------------- the windows

export component AppWindow inherits Window {
    title: App.has-song ? App.title + " · " + App.artist + " — RyM" : "RyM";
    icon: @image-url("../assets/icons/rym-slint.png");
    preferred-width: 1360px;
    preferred-height: 870px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Roboto";
    property <float> scale: max(0.5, min(1.4, min(self.width / 1600px, self.height / 1024px))) * Ui.zoom;
    changed scale => { Ui.k = self.scale; }
    init => { Ui.k = self.scale; }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == " " && App.page != 1) {
                App.toggle-play();
                return accept;
            }
            if (e.modifiers.control && (e.text == "=" || e.text == "+")) {
                App.zoom(Ui.zoom + 0.05);
                return accept;
            }
            if (e.modifiers.control && e.text == "-") {
                App.zoom(Ui.zoom - 0.05);
                return accept;
            }
            if (e.modifiers.control && e.text == "0") {
                App.zoom(0.85);
                return accept;
            }
            if (e.modifiers.control && e.text == "t") {
                App.next-theme();
                return accept;
            }
            reject
        }
    }

    Backdrop {
        width: 100%;
        height: 100%;
    }
    if !Theme.wide: Rectangle {
        NowPlaying {
            x: Ui.rtl ? root.width - self.width : 0;
            y: 0;
            width: 872px * Ui.k;
            height: max(root.height, 1024px * Ui.k);
        }
        Rail {
            x: Ui.rtl ? root.width - self.width : 0;
            y: (root.height - self.height) / 2;
            height: 640px * Ui.k;
        }
        Pages {
            x: Ui.rtl ? 0 : 900px * Ui.k;
            y: 0;
            width: root.width - 900px * Ui.k;
            height: root.height;
        }
    }
    if Theme.wide: WideLayout { width: 100%; height: 100%; }
    // The X: close, or keep playing in the background (by the clock), and maybe remember it.
    if App.close-ask: Rectangle {
        background: #00000090;
        TouchArea { }
        card := Rectangle {
            width: min(root.width - 40px, 460px);
            height: ask.preferred-height;
            border-radius: (18px) * Theme.round;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border;
            property <bool> remember;
            ask := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: App.tr("Close RyM?"); font-size: 22px; font-weight: 700; color: Theme.text; horizontal-alignment: Ui.start; }
                Text { text: App.tr("RyM can keep playing in the background, with its icon next to the clock."); font-size: 15px; color: Theme.dim; wrap: word-wrap; horizontal-alignment: Ui.start; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: Ui.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    Switch { on <=> card.remember; }
                    Text { text: App.tr("Remember my choice (Settings can change it)"); font-size: 14px; color: Theme.text; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: LayoutAlignment.end;
                    Button { text: App.tr("Close RyM"); clicked => { App.close-choice(false, card.remember); } }
                    Button { text: App.tr("Keep in background"); strong: true; clicked => { App.close-choice(true, card.remember); } }
                }
            }
        }
    }
    // A question with a text box (a playlist's name, a link to download).
    if App.prompt-open: Rectangle {
        background: #00000090;
        TouchArea { }
        Rectangle {
            width: min(root.width - 40px, 480px);
            height: pcol.preferred-height;
            border-radius: (18px) * Theme.round;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border;
            pcol := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: App.prompt-title; font-size: 21px; font-weight: 700; color: Theme.text; horizontal-alignment: Ui.start; }
                Rectangle {
                    height: 44px;
                    border-radius: (10px) * Theme.round;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: pin.has-focus ? Theme.accent : Theme.border;
                    pin := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        text <=> App.prompt-text;
                        font-size: 16px;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { App.prompt-done(true); }
                    }
                    if App.prompt-text == "": Text { x: 12px; text: App.prompt-hint; font-size: 16px; color: Theme.dim; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: LayoutAlignment.end;
                    Button { text: App.tr("Cancel"); clicked => { App.prompt-done(false); } }
                    Button { text: App.tr("OK"); strong: true; clicked => { App.prompt-done(true); } }
                }
            }
        }
    }
    // Seamless Music, asked first: play the phone's song here?
    if App.peer-ask: Rectangle {
        background: #00000070;
        TouchArea { }
        Rectangle {
            width: min(root.width - 40px, 440px);
            height: qcol.preferred-height;
            border-radius: (18px) * Theme.round;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border;
            qcol := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: App.peer-text; font-size: 17px; color: Theme.text; wrap: word-wrap; horizontal-alignment: Ui.start; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: LayoutAlignment.end;
                    Button { text: App.tr("Not now"); clicked => { App.peer-choice(false); } }
                    Button { text: App.tr("Play here"); strong: true; clicked => { App.peer-choice(true); } }
                }
            }
        }
    }
    // A short notice at the bottom.
    if App.toast != "": Rectangle {
        y: root.height - (Theme.wide ? 150px : 90px);
        x: (root.width - self.width) / 2;
        width: min(root.width - 40px, note.preferred-width + 48px);
        height: 48px;
        border-radius: (24px) * Theme.round;
        background: Theme.dark ? #1d1c28ee : #222222ee;
        note := Text {
            text: App.toast;
            font-size: 16px;
            color: #ffffff;
            overflow: elide;
        }
    }
}

// The mini player: cover, song, previous / play / next, above the other windows.
export component MiniWindow inherits Window {
    title: "RyM mini player";
    icon: @image-url("../assets/icons/rym-slint.png");
    width: 420px;
    height: 96px;
    no-frame: true;
    always-on-top: true;
    background: Theme.bg;
    default-font-family: "Roboto";
    callback hide-mini();
    callback drag(length, length);
    Rectangle {
        border-radius: (14px) * Theme.round;
        border-width: 1px;
        border-color: Theme.border;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 76px;
            border-radius: (8px) * Theme.round;
            clip: true;
            Image { width: 100%; height: 100%; source: App.cover; image-fit: cover; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: App.has-song ? App.title : App.tr("Nothing playing"); font-size: 17px; font-weight: 700; color: Theme.text; overflow: elide; }
            Text { text: App.artist; font-size: 14px; color: Theme.dim; overflow: elide; }
        }
        for b in [
            { id: 0, icon: @image-url("icons/previous.svg"), size: 34px },
            { id: 1, icon: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play-bold-duotone.svg"), size: 46px },
            { id: 2, icon: @image-url("icons/next.svg"), size: 34px },
            { id: 3, icon: @image-url("icons/close-circle-linear.svg"), size: 28px },
        ]: VerticalLayout {
            alignment: center;
            Icon {
                size: b.size;
                source: b.icon;
                clicked => {
                    if (b.id == 0) { App.previous(); }
                    if (b.id == 1) { App.toggle-play(); }
                    if (b.id == 2) { App.next(); }
                    if (b.id == 3) { root.hide-mini(); }
                }
            }
        }
    }
}

// The floating lyrics: the sung line and the next one, above every window; dragged to move.
export component FloatWindow inherits Window {
    title: "RyM floating lyrics";
    width: 760px;
    height: 120px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Roboto";
    in property <string> now;
    in property <string> next;
    in property <color> accent: #ea814a;
    callback hide-float();
    callback drag(length, length);
    Rectangle {
        border-radius: (18px) * Theme.round;
        background: #0e0e14c8;
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        double-clicked => { root.hide-float(); }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: center;
        Text { text: root.now; font-size: 30px; font-weight: 700; color: #ffffff; horizontal-alignment: center; overflow: elide; }
        Text { text: root.next; font-size: 19px; color: #ffffffa0; horizontal-alignment: center; overflow: elide; }
    }
    Text {
        x: parent.width - 26px;
        y: 6px;
        text: "×";
        font-size: 18px;
        color: close.has-hover ? root.accent : #ffffff80;
        close := TouchArea { mouse-cursor: pointer; clicked => { root.hide-float(); } }
    }
}

// A song as a picture to share: the cover, the song, a line of its lyrics, and RyM.
export component ShareWindow inherits Window {
    title: "RyM — share";
    icon: @image-url("../assets/icons/rym-slint.png");
    width: 560px;
    height: 720px;
    background: #121218;
    default-font-family: "Roboto";
    in property <image> cover;
    in property <image> backdrop;
    in property <string> song;
    in property <string> artist;
    in property <string> line;
    in property <color> accent: #ea814a;
    in-out property <bool> capturing;
    callback save();
    callback copy();
    Image { width: 100%; height: 100%; source: root.backdrop; image-fit: ImageFit.cover; opacity: 0.45; }
    VerticalLayout {
        padding: 40px;
        spacing: 18px;
        Rectangle {
            height: 480px;
            border-radius: (16px) * Theme.round;
            clip: true;
            Image { width: 100%; height: 100%; source: root.cover; image-fit: ImageFit.cover; }
        }
        Text { text: root.song; font-size: 30px; font-weight: 700; color: #ffffff; overflow: elide; }
        Text { text: root.artist; font-size: 20px; color: #ffffffb0; overflow: elide; }
        if root.line != "": Text { text: "“" + root.line + "”"; font-size: 18px; color: root.accent; wrap: word-wrap; }
    }
    Text {
        x: parent.width - self.width - 22px;
        y: parent.height - self.height - 16px;
        text: "RyM";
        font-size: 18px;
        font-weight: 300;
        letter-spacing: 2px;
        color: #ffffffa0;
    }
    if !root.capturing: HorizontalLayout {
        x: 20px;
        y: 16px;
        spacing: 10px;
        for b in [{ id: 0, label: App.tr("Save picture") }, { id: 1, label: App.tr("Copy") }]: Rectangle {
            height: 38px;
            width: lbl.preferred-width + 30px;
            border-radius: (19px) * Theme.round;
            background: ba.has-hover ? root.accent.darker(0.1) : root.accent;
            lbl := Text { text: b.label; font-size: 15px; color: #ffffff; }
            ba := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (b.id == 0) { root.save(); }
                    if (b.id == 1) { root.copy(); }
                }
            }
        }
    }
}
